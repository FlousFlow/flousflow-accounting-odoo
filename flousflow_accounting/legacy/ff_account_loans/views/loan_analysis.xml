<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="loan_line_list_view" model="ir.ui.view">
        <field name="name">flousflow.account.loan.line.analysis.list</field>
        <field name="model">flousflow.account.loan.line</field>
        <field name="arch" type="xml">
            <list string="Loans Analysis">
                <field name="date"/>
                <field name="loan_id"/>
                <field name="principal_amount" sum="Principal"/>
                <field name="interest_amount" sum="Interest"/>
                <field name="payment_amount" sum="Payment"/>
            </list>
        </field>
    </record>
    <record id="loan_line_search_view" model="ir.ui.view">
        <field name="name">flousflow.account.loan.line.analysis.search</field>
        <field name="model">flousflow.account.loan.line</field>
        <field name="arch" type="xml">
            <search string="Loans Analysis">
                <field name="loan_id"/>
                <field name="date"/>
                <separator/>
                <filter name="group_year" string="Year" domain="[]" context="{'group_by': 'date:year'}"/>
                <filter name="group_loan" string="Loan" domain="[]" context="{'group_by': 'loan_id'}"/>
            </search>
        </field>
    </record>
    <record id="loan_line_pivot_view" model="ir.ui.view">
        <field name="name">flousflow.account.loan.line.analysis.pivot</field>
        <field name="model">flousflow.account.loan.line</field>
        <field name="arch" type="xml">
            <pivot string="Loans Analysis" display_quantity="0">
                <field name="date" interval="year" type="row"/>
                <field name="loan_id" type="row"/>
                <field name="principal_amount" type="measure" string="Principal"/>
                <field name="interest_amount" type="measure" string="Interest"/>
                <field name="payment_amount" type="measure" string="Payment"/>
            </pivot>
        </field>
    </record>
    <record id="loan_line_graph_view" model="ir.ui.view">
        <field name="name">flousflow.account.loan.line.analysis.graph</field>
        <field name="model">flousflow.account.loan.line</field>
        <field name="arch" type="xml">
            <graph string="Loans Analysis" type="bar">
                <field name="date" interval="year"/>
                <field name="principal_amount" type="measure"/>
                <field name="interest_amount" type="measure"/>
                <field name="payment_amount" type="measure"/>
            </graph>
        </field>
    </record>
    <record id="loan_analysis_action" model="ir.actions.act_window">
        <field name="name">Loans Analysis</field>
        <field name="res_model">flousflow.account.loan.line</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="loan_line_search_view"/>
        <field name="context">{'search_default_group_year': 1}</field>
    </record>
    <menuitem id="loan_analysis_menu" name="Loans Analysis" parent="account.account_audit_control_menu"
              action="loan_analysis_action" sequence="55" groups="account.group_account_readonly"/>
</odoo>
