<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="apr__account_report_general_ledger_view" model="ir.ui.view">
        <field name="name">General Ledger</field>
        <field name="model">account.report.general.ledger</field>
        <field name="inherit_id" ref="flousflow_accounting.apr__account_common_report_view"/>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//field[@name='journal_ids']" position="after">
                    <field name="analytic_account_ids" widget="many2many_tags"
                           options="{'no_open': True, 'no_create': True}"
                           invisible="1"
                           groups="analytic.group_analytic_accounting"/>
                    <field name="account_ids" widget="many2many_tags"
                           options="{'no_open': True, 'no_create': True}"/>
                    <field name="partner_ids" widget="many2many_tags"
                           options="{'no_open': True, 'no_create': True}"/>
                </xpath>
                <xpath expr="//field[@name='target_move']" position="after">
                    <field name="sortby" widget="radio"/>
                    <field name="display_account" widget="radio"/>
                    <field name="initial_balance"/>
                </xpath>
            </data>
        </field>
    </record>

    <record id="apr__action_account_general_ledger_menu" model="ir.actions.act_window">
        <field name="name">General Ledger</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">account.report.general.ledger</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="apr__account_report_general_ledger_view"/>
        <field name="target">new</field>
        <field name="binding_model_id" ref="account.model_account_account" />
        <field name="binding_type">report</field>
    </record>

    <record id="apr__action_interactive_general_ledger" model="ir.actions.client">
        <field name="name">General Ledger</field>
        <field name="tag">flousflow_accounting.apr__general_ledger</field>
        <field name="target">main</field>
    </record>

    <menuitem id="apr__menu_general_ledger"
              name="General Ledger"
              sequence="20"
              parent="apr__menu_finance_reporting_ledgers"
              action="apr__action_interactive_general_ledger"
              groups="account.group_account_readonly,account.group_account_manager"/>

</odoo>
