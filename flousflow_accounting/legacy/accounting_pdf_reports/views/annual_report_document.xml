<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="apr__view_annual_report_document_search" model="ir.ui.view">
        <field name="name">account.annual.report.document.search</field>
        <field name="model">account.annual.report.document</field>
        <field name="arch" type="xml">
            <search string="Annual Reports">
                <field name="name"/>
                <field name="responsible_user_ids"/>
                <field name="template_id"/>
                <filter name="my_reports" string="My Reports" domain="[('responsible_user_ids', 'in', uid)]"/>
                <group>
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
                    <filter name="group_template" string="Template" context="{'group_by': 'template_id'}"/>
                    <filter name="group_responsible" string="Responsible" context="{'group_by': 'responsible_user_ids'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="apr__view_annual_report_document_kanban" model="ir.ui.view">
        <field name="name">account.annual.report.document.kanban</field>
        <field name="model">account.annual.report.document</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_small_column" create="1" quick_create="false">
                <field name="name"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="company_id"/>
                <field name="template_id"/>
                <field name="responsible_user_ids"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top mb-2">
                                <strong class="o_kanban_record_title"><field name="name"/></strong>
                            </div>
                            <div class="text-muted">
                                <field name="date_from"/> – <field name="date_to"/>
                            </div>
                            <div class="mt-2"><field name="template_id"/></div>
                            <div class="mt-2"><field name="responsible_user_ids" widget="many2many_tags"/></div>
                            <div class="mt-2"><field name="company_id"/></div>
                            <footer class="pt-2">
                                <button name="action_print_pdf" type="object" class="btn btn-primary btn-sm"
                                        groups="account.group_account_readonly,account.group_account_manager">
                                    Print PDF
                                </button>
                            </footer>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="apr__view_annual_report_document_list" model="ir.ui.view">
        <field name="name">account.annual.report.document.list</field>
        <field name="model">account.annual.report.document</field>
        <field name="arch" type="xml">
            <list string="Annual Reports">
                <field name="name"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="template_id" optional="show"/>
                <field name="responsible_user_ids" widget="many2many_tags" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </list>
        </field>
    </record>

    <record id="apr__view_annual_report_document_form" model="ir.ui.view">
        <field name="name">account.annual.report.document.form</field>
        <field name="model">account.annual.report.document</field>
        <field name="arch" type="xml">
            <form string="Annual Report">
                <header>
                    <button name="action_print_pdf" type="object" string="Print Complete PDF"
                            class="oe_highlight" groups="account.group_account_readonly,account.group_account_manager"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Title"/>
                        <h1><field name="name" placeholder="Example, Annual Financial Overview FY"/></h1>
                    </div>
                    <group>
                        <group string="Report Details">
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Preparation">
                            <field name="responsible_user_ids" widget="many2many_tags"
                                   domain="[('company_ids', 'in', company_id)]"/>
                            <field name="template_id" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Content" name="content">
                            <field name="section_ids" context="{'default_report_id': id}">
                                <list editable="bottom" default_order="sequence">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="page_break_before"/>
                                </list>
                                <form string="Report Section">
                                    <group>
                                        <field name="name"/>
                                        <field name="sequence"/>
                                        <field name="page_break_before"/>
                                        <field name="content" widget="html"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                        <page string="Attachments" name="attachments">
                            <field name="attachment_ids" widget="many2many_binary"
                                   domain="[('company_id', 'in', allowed_company_ids)]"/>
                            <div class="text-muted">
                                PDF files are appended to the report. Image files are shown in the appendix.
                                Other file types are listed by name.
                            </div>
                        </page>
                    </notebook>
                    <chatter/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="apr__action_annual_report_documents" model="ir.actions.act_window">
        <field name="name">Annual Reports</field>
        <field name="res_model">account.annual.report.document</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="apr__view_annual_report_document_search"/>
        <field name="context">{'default_responsible_user_ids': [(6, 0, [uid])]}</field>
    </record>
    <record id="apr__action_annual_report_documents_kanban" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="apr__view_annual_report_document_kanban"/>
        <field name="act_window_id" ref="apr__action_annual_report_documents"/>
    </record>
    <record id="apr__action_annual_report_documents_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="apr__view_annual_report_document_list"/>
        <field name="act_window_id" ref="apr__action_annual_report_documents"/>
    </record>
    <record id="apr__action_annual_report_documents_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="3"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="apr__view_annual_report_document_form"/>
        <field name="act_window_id" ref="apr__action_annual_report_documents"/>
    </record>

    <record id="apr__menu_account_report_annual" model="ir.ui.menu">
        <field name="name">Annual Report</field>
        <field name="action" ref="apr__action_annual_report_documents"/>
        <field name="group_ids" eval="[(6, 0, [ref('account.group_account_readonly'), ref('account.group_account_manager')])]"/>
    </record>
    <menuitem id="apr__menu_account_annual_report_generator" name="Generate Financial Statements"
              action="apr__action_account_annual_report" parent="account.account_reports_legal_statements_menu"
              groups="account.group_account_readonly,account.group_account_manager" sequence="51"/>

    <record id="apr__view_annual_report_template_tree" model="ir.ui.view">
        <field name="name">account.annual.report.template.list</field>
        <field name="model">account.annual.report.template</field>
        <field name="arch" type="xml">
            <list string="Annual Report Templates">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="apr__view_annual_report_template_form" model="ir.ui.view">
        <field name="name">account.annual.report.template.form</field>
        <field name="model">account.annual.report.template</field>
        <field name="arch" type="xml">
            <form string="Annual Report Template">
                <sheet>
                    <div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div>
                    <group>
                        <field name="description"/>
                        <field name="sequence"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="active" widget="boolean_toggle"/>
                    </group>
                    <field name="section_ids">
                        <list editable="bottom" default_order="sequence">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="page_break_before"/>
                        </list>
                        <form string="Template Section">
                            <group>
                                <field name="name"/>
                                <field name="sequence"/>
                                <field name="page_break_before"/>
                                <field name="content" widget="html"/>
                            </group>
                        </form>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="apr__action_annual_report_templates" model="ir.actions.act_window">
        <field name="name">Annual Report Templates</field>
        <field name="res_model">account.annual.report.template</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="apr__view_annual_report_template_tree"/>
    </record>
    <menuitem id="apr__menu_annual_report_templates" name="Annual Report Templates"
              action="apr__action_annual_report_templates" parent="account.menu_finance_configuration"
              groups="account.group_account_manager" sequence="90"/>
</odoo>
