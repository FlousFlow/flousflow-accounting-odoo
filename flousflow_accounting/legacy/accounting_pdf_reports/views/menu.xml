<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- the financial statements, the partner and the tax reports go into the folders of the account module:
         Statement Reports, Partner Reports, Taxes & Fiscal -->

    <!-- the administrators run the financial statements, but only imply the invoicing group -->
    <record id="account.account_reports_legal_statements_menu" model="ir.ui.menu">
        <field name="group_ids" eval="[(4, ref('account.group_account_manager'))]"/>
    </record>

    <menuitem id="apr__menu_finance_audit_reports"
              name="Audit Reports"
              sequence="30"
              parent="account.menu_finance_reports"/>

    <!-- Match Enterprise's Reporting > Ledgers hierarchy. Journal-item shortcuts
         remain under Accounting > Journal Items because they are a different view. -->
    <menuitem id="apr__menu_finance_reporting_ledgers"
              name="Ledgers"
              sequence="20"
              parent="account.menu_finance_reports"/>

    <record id="account.account_reports_management_menu" model="ir.ui.menu">
        <field name="sequence" eval="40"/>
    </record>

    <record id="apr__view_analytic_profitability_form" model="ir.ui.view">
        <field name="name">account.analytic.profitability.form</field>
        <field name="model">account.analytic.profitability</field>
        <field name="arch" type="xml">
            <form string="Analytic Profitability">
                <group>
                    <group string="Period">
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="posted_only"/>
                    </group>
                    <group string="Analytic Scope">
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="analytic_plan_id" options="{'no_create': True}"/>
                        <field name="analytic_account_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    </group>
                </group>
                <group string="Totals" invisible="not line_ids">
                    <group>
                        <field name="total_revenue" readonly="1"/>
                        <field name="total_cogs" readonly="1"/>
                        <field name="total_operating_expenses" readonly="1"/>
                    </group>
                    <group>
                        <field name="total_other_income" readonly="1"/>
                        <field name="total_other_expenses" readonly="1"/>
                        <field name="total_net_profit" readonly="1"/>
                    </group>
                </group>
                <field name="movement_count" invisible="1"/>
                <separator string="Profitability by Analytic Account"/>
                <field name="line_ids" nolabel="1" readonly="1">
                    <list create="0" delete="0" edit="0">
                        <field name="analytic_account_id"/>
                        <field name="movement_count"/>
                        <field name="revenue" sum="Total Revenue"/>
                        <field name="cogs" sum="Total COGS"/>
                        <field name="operating_expenses" sum="Total Expenses"/>
                        <field name="other_income" optional="hide"/>
                        <field name="other_expenses" optional="hide"/>
                        <field name="net_profit" sum="Net Profit" decoration-success="net_profit &gt;= 0" decoration-danger="net_profit &lt; 0"/>
                        <field name="margin_percent" widget="percentage"/>
                    </list>
                </field>
                <footer>
                    <button name="action_generate" string="Generate Report" type="object" class="btn-primary" data-hotkey="g"/>
                    <button name="action_print" string="Print PDF" type="object" class="btn-primary" data-hotkey="p"/>
                    <button name="action_view_movements" string="View Movements" type="object" class="btn-secondary"/>
                    <button string="Close" class="btn-secondary" special="cancel" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="apr__action_analytic_profitability" model="ir.actions.act_window">
        <field name="name">Analytic Profitability</field>
        <field name="res_model">account.analytic.profitability</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="apr__menu_analytic_profitability"
              name="Analytic Profitability"
              sequence="25"
              parent="account.account_reports_management_menu"
              action="apr__action_analytic_profitability"
              groups="account.group_account_readonly,account.group_account_invoice"/>

    <record id="apr__access_account_analytic_profitability" model="ir.access">
        <field name="name">Analytic Profitability</field>
        <field name="model_id" ref="model_account_analytic_profitability"/>
        <field name="group_id" ref="account.group_account_readonly"/>
        <field name="operation">crud</field>
    </record>

    <record id="apr__access_account_analytic_profitability_line" model="ir.access">
        <field name="name">Analytic Profitability Lines</field>
        <field name="model_id" ref="model_account_analytic_profitability_line"/>
        <field name="group_id" ref="account.group_account_readonly"/>
        <field name="operation">crud</field>
    </record>

    <record id="apr__view_sale_order_sales_analysis_search" model="ir.ui.view">
        <field name="name">sale.order.sales.analysis.search</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <search string="Sales by Salesperson and Team">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="user_id" string="Salesperson"/>
                <field name="team_id" string="Sales Team"/>
                <field name="date_order"/>
                <filter name="confirmed_sales" string="Confirmed Sales" domain="[('state', 'in', ('sale', 'done'))]"/>
                <filter name="this_year" string="This Year" domain="[('date_order', '&gt;=', context_today().strftime('%Y-01-01'))]"/>
                <filter name="group_salesperson" string="Salesperson" context="{'group_by': 'user_id'}"/>
                <filter name="group_sales_team" string="Sales Team" context="{'group_by': 'team_id'}"/>
                <filter name="group_month" string="Month" context="{'group_by': 'date_order:month'}"/>
                <filter name="group_customer" string="Customer" context="{'group_by': 'partner_id'}"/>
            </search>
        </field>
    </record>

    <record id="apr__view_sale_order_sales_analysis_list" model="ir.ui.view">
        <field name="name">sale.order.sales.analysis.list</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <list string="Sales by Salesperson and Team" create="0" edit="0" delete="0">
                <field name="date_order"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="user_id" optional="show"/>
                <field name="team_id" optional="show"/>
                <field name="state"/>
                <field name="invoice_status" optional="hide"/>
                <field name="amount_untaxed" sum="Untaxed Sales"/>
                <field name="amount_total" sum="Total Sales"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="company_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="apr__view_sale_order_sales_analysis_pivot" model="ir.ui.view">
        <field name="name">sale.order.sales.analysis.pivot</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <pivot string="Sales by Salesperson and Team">
                <field name="user_id" type="row"/>
                <field name="team_id" type="row"/>
                <field name="date_order" type="col" interval="month"/>
                <field name="amount_untaxed" type="measure"/>
                <field name="amount_total" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="apr__view_sale_order_sales_analysis_graph" model="ir.ui.view">
        <field name="name">sale.order.sales.analysis.graph</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <graph string="Sales by Salesperson and Team" type="bar">
                <field name="user_id" type="row"/>
                <field name="amount_total" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="apr__action_salesperson_team_sales" model="ir.actions.act_window">
        <field name="name">Sales by Salesperson and Team</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,pivot,graph,form</field>
        <field name="domain">[('state', 'in', ('sale', 'done'))]</field>
        <field name="search_view_id" ref="apr__view_sale_order_sales_analysis_search"/>
        <field name="context">{
            'search_default_confirmed_sales': 1,
            'search_default_group_salesperson': 1,
            'search_default_group_sales_team': 1,
            'create': False
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No confirmed sales yet.</p>
            <p>Review confirmed sales by salesperson, sales team, customer, or month.</p>
        </field>
    </record>

    <menuitem id="apr__menu_salesperson_team_sales" name="Sales by Salesperson and Team"
              parent="account.account_reports_management_menu" action="apr__action_salesperson_team_sales"
              sequence="15" groups="account.group_account_readonly,account.group_account_invoice"/>
</odoo>

