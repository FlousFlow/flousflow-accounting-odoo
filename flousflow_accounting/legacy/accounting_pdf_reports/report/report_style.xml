<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- The look of every report in this module, in one place.

         Kept as a template the reports t-call rather than an entry in an asset bundle:
         these styles are for printed pages only, and a bundle entry would be loaded by
         every screen in Odoo to serve nine PDFs. -->
    <template id="apr__report_style">
        <style>
            /* ---------------------------------------------------------- headings */
            .o_om_report h2 {
                font-size: 20px; font-weight: 600; margin: 0 0 4px 0;
                padding-bottom: 6px; border-bottom: 2px solid #2b2b2b;
            }
            .o_om_report h3 { font-size: 15px; font-weight: 600; margin: 20px 0 8px 0; }
            .o_om_report h4 { font-size: 13px; font-weight: 600; margin: 18px 0 6px 0; }

            /* The period / target moves / journals block every report opens with. The
               labels become quiet small-caps so the figures beneath them lead. */
            .o_om_report #informations,
            .o_om_report .o_om_info { font-size: 12px; margin: 14px 0 20px 0; }
            .o_om_report #informations strong,
            .o_om_report .o_om_info strong {
                display: block; font-size: 9px; font-weight: 600; letter-spacing: .08em;
                text-transform: uppercase; color: #6b7280;
            }

            /* ---------------------------------------------------------- tables */
            /* Horizontal rules only. Boxing every cell is what makes a report look
               like a spreadsheet printout. */
            .o_om_report table { width: 100%; border-collapse: collapse; font-size: 12px; }
            .o_om_report table th,
            .o_om_report table td {
                border: 0 !important;
                border-bottom: 1px solid #ececec !important;
                padding: 5px 8px;
                vertical-align: top;
            }
            .o_om_report table thead th {
                border-bottom: 1.5px solid #2b2b2b !important;
                font-size: 9.5px; font-weight: 600; letter-spacing: .06em;
                text-transform: uppercase; color: #4b5563; white-space: nowrap;
                vertical-align: bottom;
            }
            .o_om_report table tbody tr:nth-child(even) td { background-color: #fbfbfb; }
            .o_om_report .ff_financial_print_table tbody tr.o_om_section td {
                background-color: #d8dee7 !important; font-weight: 700; text-transform: uppercase;
            }
            .o_om_report .ff_financial_print_table tbody tr.o_om_group td { font-weight: 600; }

            /* Figures: aligned digits, and never broken across two lines. */
            .o_om_report table th.text-end,
            .o_om_report table td.text-end {
                font-variant-numeric: tabular-nums; white-space: nowrap;
            }

            /* A total that closes a table reads as a total. */
            .o_om_report table tbody tr.o_om_total td {
                border-top: 1.5px solid #2b2b2b !important;
                border-bottom: 0 !important;
                font-weight: 600; background-color: transparent !important;
            }
            /* One rule above the totals, not one between each of them. */
            .o_om_report table tbody tr.o_om_total + tr.o_om_total td { border-top: 0 !important; }

            /* A date broken across two lines is never what anyone wants. */
            .o_om_report .o_om_date, .o_om_report td.o_om_date { white-space: nowrap; }

            .o_om_report .text-muted { color: #6b7280 !important; }

            .o_om_report .o_ff_balance_confirmation { margin: 8px 0; font-size: 13px; line-height: 1.65; direction: rtl; text-align: right; }
            .o_om_report .o_ff_confirmation_meta { border: 1.5px solid #111; border-radius: 10px; padding: 6px 14px 8px; margin-bottom: 14px; text-align: right; }
            .o_om_report .o_ff_confirmation_meta_title { margin: 4px 0; text-align: center; font-size: 16px; font-weight: 700; }
            .o_om_report .o_ff_confirmation_recipient { margin: 0 8px 12px; line-height: 1.9; }
            .o_om_report .o_ff_confirmation_request,
            .o_om_report .o_ff_confirmation_response { border: 2px solid #111; padding: 10px 14px 12px; margin: 0 0 14px; }
            .o_om_report .o_ff_confirmation_response { border-style: dashed; }
            .o_om_report .o_ff_confirmation_request h3,
            .o_om_report .o_ff_confirmation_response h3 { margin: 0 0 6px; color: #7a1b16; font-size: 15px; font-weight: 700; }
            .o_om_report .o_ff_confirmation_request p,
            .o_om_report .o_ff_confirmation_response p { margin: 5px 0; }
            .o_om_report .o_ff_confirmation_amount_grid { display: table; width: 100%; margin: 8px 0; border-spacing: 0 3px; font-size: 14px; }
            .o_om_report .o_ff_confirmation_amount_grid > div { display: table-cell; vertical-align: middle; padding-left: 10px; }
            .o_om_report .o_ff_confirmation_amount_words { display: block !important; padding-top: 2px; font-size: 12px; }
            .o_om_report .o_ff_confirmation_note { font-size: 11px; }
            .o_om_report .o_ff_confirmation_signatures { position: relative; min-height: 84px; margin-top: 8px; padding-left: 52%; }
            .o_om_report .o_ff_confirmation_signatures > div { margin: 4px 0; white-space: nowrap; }
            .o_om_report .o_ff_signature_line { display: inline-block; min-width: 130px; margin-right: 6px; border-bottom: 1px dotted #111; height: 1em; vertical-align: bottom; }
            .o_om_report .o_ff_confirmation_manager { position: absolute; left: 7%; bottom: 3px; font-weight: 600; }
            .o_om_report .o_ff_confirmation_response_fields { margin-top: 12px; width: 58%; margin-right: 0; }
            .o_om_report .o_ff_confirmation_response_fields > div { margin: 5px 0; white-space: nowrap; }
            .o_om_report .o_ff_confirmation_response_fields .o_ff_signature_line { min-width: 165px; }
            .o_om_report .o_ff_confirmation_closing { margin-top: 10px !important; }
        </style>
    </template>

</odoo>
