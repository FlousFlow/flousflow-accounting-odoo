<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="apr__report_partnerledger">
        <t t-call="web.html_container">
            <t t-call="web.internal_layout"
                data_report_dpi="110">
                <div class="page o_om_report">
                        <t t-call="flousflow_accounting.apr__report_style"/>
                    <h2 t-if="data['form'].get('document_type') == 'balance_confirmation'"
                        t-out="confirmation_labels['title']"/>
                    <h2 t-else="">Partner Ledger</h2>

                    <div id="informations" class="row mb-4">
                        <div class="col" t-if="data['form']['date_from'] or data['form']['date_to']">
                            <strong t-if="data['form'].get('document_type') == 'balance_confirmation'"
                                    t-out="confirmation_labels['period']"/>
                            <strong t-else="">Period:</strong>
                            <div>
                                <t t-if="data['form']['date_from'] and data['form']['date_to']"><span t-out="data['form']['date_from']" t-options="{'widget': 'date'}"/> - <span t-out="data['form']['date_to']" t-options="{'widget': 'date'}"/></t>
                                <t t-elif="data['form']['date_from']">From <span t-out="data['form']['date_from']" t-options="{'widget': 'date'}"/></t>
                                <t t-else="">Until <span t-out="data['form']['date_to']" t-options="{'widget': 'date'}"/></t>
                            </div>
                        </div>
                        <div class="col">
                            <strong t-if="data['form'].get('document_type') == 'balance_confirmation'"
                                    t-out="confirmation_labels['target_moves']"/>
                            <strong t-else="">Target Moves:</strong>
                            <div t-if="data['form']['target_move'] == 'all' and data['form'].get('document_type') == 'balance_confirmation'"
                                 t-out="confirmation_labels['all_entries']"/>
                            <div t-elif="data['form']['target_move'] == 'all'">All Entries</div>
                            <div t-if="data['form']['target_move'] == 'posted' and data['form'].get('document_type') == 'balance_confirmation'"
                                 t-out="confirmation_labels['all_posted_entries']"/>
                            <div t-elif="data['form']['target_move'] == 'posted'">All Posted Entries</div>
                        </div>
                        <div class="col">
                            <strong t-if="data['form'].get('document_type') == 'balance_confirmation'"
                                    t-out="confirmation_labels['partners']"/>
                            <strong t-else="">Partners:</strong>
                            <div t-if="data['form'].get('result_selection') == 'customer' and data['form'].get('document_type') == 'balance_confirmation'"
                                 t-out="confirmation_labels['receivable_accounts']"/>
                            <div t-elif="data['form'].get('result_selection') == 'customer'">Receivable Accounts</div>
                            <div t-if="data['form'].get('result_selection') == 'supplier' and data['form'].get('document_type') == 'balance_confirmation'"
                                 t-out="confirmation_labels['payable_accounts']"/>
                            <div t-elif="data['form'].get('result_selection') == 'supplier'">Payable Accounts</div>
                            <div t-if="data['form'].get('result_selection') == 'customer_supplier' and data['form'].get('document_type') == 'balance_confirmation'"
                                 t-out="confirmation_labels['receivable_and_payable_accounts']"/>
                            <div t-elif="data['form'].get('result_selection') == 'customer_supplier'">Receivable and Payable Accounts</div>
                        </div>
                    </div>

                    <div t-if="data['form'].get('document_type') == 'balance_confirmation'"
                         class="o_ff_balance_confirmation" t-foreach="docs" t-as="o">
                        <p><t t-out="confirmation_labels['dear']"/> <strong t-out="o.display_name"/>,</p>
                        <p t-out="confirmation_labels['request_review']"/>
                        <div class="o_ff_confirmation_amount">
                            <strong t-out="confirmation_labels['closing_balance']"/>
                            <span t-out="data['form']['date_to']" t-options="{'widget': 'date'}"/>
                            <span>:</span>
                            <strong t-out="confirmation_closing_balance(o)"
                                    t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                        </div>
                        <p class="text-muted" t-out="confirmation_labels['balance_sign_note']"/>
                        <div class="o_ff_confirmation_responses">
                            <div><span class="o_ff_confirmation_checkbox"/><t t-out="confirmation_labels['agree']"/></div>
                            <div><span class="o_ff_confirmation_checkbox"/><t t-out="confirmation_labels['disagree']"/></div>
                        </div>
                        <p class="text-muted" t-out="confirmation_labels['disclaimer']"/>
                    </div>

                    <t t-if="data['form'].get('document_type') != 'balance_confirmation'">
                    <table class="table table-sm table-reports">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>JRNL</th>
                                <th>Account</th>
                                <th>Ref</th>
                                <th class="text-end">Debit</th>
                                <th class="text-end">Credit</th>
                                <th class="text-end">Balance</th>
                                <th class="text-end" t-if="data['form']['amount_currency']">Currency</th>
                            </tr>
                        </thead>
                        <t t-foreach="docs" t-as="o">
                            <tbody>
                                <tr>
                                    <td colspan="4">
                                        <strong t-if="o.ref" t-out="o.ref"/>
                                        <t t-if="o.ref"> - </t>
                                        <strong t-out="o.name"/>
                                    </td>
                                    <td class="text-end text-nowrap">
                                        <strong t-out="sum_partner(data, o, 'debit')"
                                                t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                    </td>
                                    <td class="text-end text-nowrap">
                                        <strong t-out="sum_partner(data, o, 'credit')"
                                                t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                    </td>
                                    <td class="text-end text-nowrap">
                                        <strong t-out="sum_partner(data, o, 'debit - credit')"
                                                t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                    </td>
                                    <td t-if="data['form']['amount_currency']"/>
                                </tr>
                                <t t-set="rows" t-value="lines(data, o)"/>
                                <tr t-foreach="rows" t-as="line">
                                    <td>
                                        <span class="o_om_date" t-out="line['date']"/>
                                    </td>
                                    <td>
                                        <span t-out="line['code']"/>
                                    </td>
                                    <td>
                                        <span t-if="line_index == 0 or rows[line_index - 1]['a_name'] != line['a_name']"
                                              t-out="line['a_name']"/>
                                    </td>
                                    <td>
                                        <span t-out="line['displayed_name']"/>
                                    </td>
                                    <td class="text-end text-nowrap">
                                        <span t-out="line['debit']"
                                              t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                    </td>
                                    <td class="text-end text-nowrap">
                                        <span t-out="line['credit']"
                                              t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                    </td>
                                    <td class="text-end text-nowrap">
                                        <span t-out="line['progress']"
                                              t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                    </td>
                                    <td class="text-end text-nowrap" t-if="data['form']['amount_currency']">
                                        <t t-if="line['currency_id']">
                                            <span t-out="line['amount_currency']"
                                                  t-options="{'widget': 'monetary', 'display_currency': line['currency_id']}"/>
                                        </t>
                                    </td>
                                </tr>
                            </tbody>
                        </t>
                        <tfoot t-if="docs">
                            <tr class="o_om_total">
                                <td colspan="4"><strong>Total</strong></td>
                                <td class="text-end text-nowrap">
                                    <strong t-out="sum(sum_partner(data, partner, 'debit') for partner in docs)"
                                            t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                </td>
                                <td class="text-end text-nowrap">
                                    <strong t-out="sum(sum_partner(data, partner, 'credit') for partner in docs)"
                                            t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                </td>
                                <td class="text-end text-nowrap">
                                    <strong t-out="sum(sum_partner(data, partner, 'debit - credit') for partner in docs)"
                                            t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                </td>
                                <td t-if="data['form']['amount_currency']"/>
                            </tr>
                        </tfoot>
                    </table>
                    </t>
                </div>
            </t>
        </t>
    </template>

</odoo>
