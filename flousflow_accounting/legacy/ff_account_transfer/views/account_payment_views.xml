<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fat__view_account_payment_form_inherit_transfer" model="ir.ui.view">
        <field name="name">account.payment.form.inherit.transfer</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_type']" position="after">
                <field name="is_internal_transfer" readonly="state != 'draft'"/>
                <field name="destination_journal_id"
                       invisible="not is_internal_transfer"
                       required="is_internal_transfer"
                       readonly="state != 'draft'"/>
            </xpath>
        </field>
    </record>

    <record id="fat__account_journal_dashboard_kanban_view_inherit" model="ir.ui.view">
        <field name="name">account.journal.dashboard.kanban.inherit</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.account_journal_dashboard_kanban_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='bank_customer_payment']" position="after">
                <div name="bank_internal_transfer" t-if="journal_type == 'bank' or journal_type == 'cash'">
                    <a role="menuitem" type="object" name="create_internal_transfer">Internal Transfer</a>
                </div>
            </xpath>
        </field>
    </record>

    <record id="fat__action_account_payments_transfer_custom" model="ir.actions.act_window">
        <field name="name">Internal Transfers</field>
        <field name="res_model">account.payment</field>
        <field name="view_mode">list,kanban,form,graph</field>
        <field name="context">{'default_payment_type': 'outbound', 'default_is_internal_transfer': True}</field>
        <field name="domain">[('is_internal_transfer', '=', True)]</field>
    </record>

    <menuitem id="fat__menu_action_account_payments_transfer"
              name="Internal Transfers"
              parent="account.menu_finance_entries"
              action="fat__action_account_payments_transfer_custom"
              sequence="25"
              groups="account.group_account_readonly"/>
    <template id="report_payment_receipt_document_ar" inherit_id="account.report_payment_receipt_document">
        <xpath expr="//t[@t-call='web.external_layout']" position="replace">
            <t t-call="web.external_layout" o="o" company="o.company_id.sudo()">
                <t t-set="values" t-value="o._get_payment_receipt_report_values()"/>
                <t t-set="is_arabic" t-value="(lang or '').startswith('ar')"/>
                <div class="page" t-att-dir="'rtl' if is_arabic else 'ltr'" style="font-family: DejaVu Sans, sans-serif;">
                    <div class="text-center" style="border: 1px solid #222; padding: 12px; margin-bottom: 18px;"><h2 style="margin: 0 0 6px 0;"><t t-if="is_arabic"><t t-if="o.payment_type == 'inbound'">سند قبض</t><t t-else="">سند صرف</t></t><t t-else=""><t t-if="o.payment_type == 'inbound'">Receipt Voucher</t><t t-else="">Payment Voucher</t></t></h2><div><t t-if="is_arabic">رقم السند: </t><t t-else="">Voucher No.: </t><span t-field="o.name"/></div></div>
                    <table class="table table-sm" style="width: 100%; margin-bottom: 18px;"><tbody>
                        <tr><td style="width: 22%;"><strong><t t-if="is_arabic">الطرف</t><t t-else="">Partner</t></strong></td><td><t t-if="o.partner_type == 'customer'"><t t-if="is_arabic">عميل: </t><t t-else="">Customer: </t></t><t t-else=""><t t-if="is_arabic">مورد: </t><t t-else="">Vendor: </t></t><span t-field="o.partner_id"/></td><td style="width: 22%;"><strong><t t-if="is_arabic">التاريخ</t><t t-else="">Date</t></strong></td><td><span t-field="o.date"/></td></tr>
                        <tr><td><strong><t t-if="is_arabic">طريقة الدفع</t><t t-else="">Payment Method</t></strong></td><td><span t-if="values['display_payment_method'] and o.payment_method_line_id" t-field="o.payment_method_line_id.name"/><span t-if="not (values['display_payment_method'] and o.payment_method_line_id)">—</span></td><td><strong><t t-if="is_arabic">قيمة الدفعة</t><t t-else="">Payment Amount</t></strong></td><td><strong><span t-field="o.amount" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></strong></td></tr>
                        <tr t-if="o.memo"><td><strong><t t-if="is_arabic">البيان</t><t t-else="">Memo</t></strong></td><td colspan="3"><span t-field="o.memo"/></td></tr>
                    </tbody></table>
                    <div style="border: 1px solid #888; padding: 10px; margin-top: 18px; text-align: center;">
                        <strong><t t-if="is_arabic"><t t-if="o.partner_type == 'customer'">صافي رصيد العميل بعد الدفعة: </t><t t-else="">صافي رصيد المورد بعد الدفعة: </t></t><t t-else=""><t t-if="o.partner_type == 'customer'">Customer Net Balance After Payment: </t><t t-else="">Vendor Net Balance After Payment: </t></t></strong>
                        <span t-esc="o._get_payment_receipt_net_after_payment()" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                    </div>
                    <div class="row" style="margin-top: 42px;"><div class="col-6 text-center"><t t-if="is_arabic">توقيع المستلم</t><t t-else="">Recipient Signature</t><br/><br/>................................</div><div class="col-6 text-center"><t t-if="is_arabic">توقيع المسؤول</t><t t-else="">Authorized Signature</t><br/><br/>................................</div></div>
                </div>
            </t>
        </xpath>
    </template>
    <template id="report_payment_receipt_ar" inherit_id="account.report_payment_receipt">
        <xpath expr="//t[@t-set='lang']" position="attributes"><attribute name="t-value">o.env.context.get('lang') or env.user.lang or o.company_id.partner_id.lang</attribute></xpath>
        <xpath expr="//t[@t-call='account.report_payment_receipt_document']" position="replace"><t t-call="flousflow_accounting.report_payment_receipt_document_ar" t-lang="lang"/></xpath>
    </template>
</odoo>
