<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="acc__res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.accountant</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="attributes">
                <attribute name="data-string">Accounting</attribute>
                <attribute name="string">Accounting</attribute>
            </xpath>
            <xpath expr="//field[@name='account_use_credit_limit']" position="after">
                <div class="content-group mt-2" invisible="not account_use_credit_limit">
                    <field name="credit_limit_block"/>
                    <label for="credit_limit_block" class="o_light_label"
                           string="Refuse to post an invoice going over the limit"/>
                    <div class="text-muted">
                        The accounting managers can still post it: the override is logged on the invoice.
                    </div>
                    <div class="row mt-2">
                        <label for="credit_limit_scope" class="col-lg-4 o_light_label"/>
                        <field name="credit_limit_scope" widget="radio" options="{'horizontal': true}"/>
                    </div>
                    <div class="text-muted">
                        Use the company default for all customers, while allowing an explicitly configured contact limit to override it.
                    </div>
                </div>
            </xpath>
            <app name="account" position="inside">
                <div class="row mt16 o_settings_container" name="salesperson_credit_limit_container">
                    <div class="col-12 col-lg-6 o_setting_box" id="salesperson_credit_limit">
                        <div class="o_setting_left_pane">
                            <field name="salesperson_credit_limit_block"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="salesperson_credit_limit_block" string="Enforce Salesperson Credit Limits"/>
                            <div class="text-muted">
                                Refuse confirming a sales order when the salesperson's open exposure exceeds the configured limit.
                                Sales managers and accounting managers can override the block.
                            </div>
                        </div>
                    </div>
                </div>
            </app>
            <app name="account" position="inside">
                <h2>Anglo-Saxon Accounting</h2>
                <div class="row mt16 o_settings_container"
                    name="anglo_saxon_setting_container">
                    <div class="col-12 col-lg-6 o_setting_box" id="anglo_saxon">
                        <div class="o_setting_left_pane">
                            <field name="anglo_saxon_accounting" />
                        </div>
                        <div class="o_setting_right_pane">
                            <label string="Anglo-Saxon Accounting"
                                for="anglo_saxon_accounting"/>
                            <div class="text-muted">
                                Record the cost of a good as an expense when this good is
                                invoiced to a final customer (instead of recording the cost as soon
                                as the product is received in stock).
                            </div>
                        </div>
                    </div>
                </div>
            </app>
        </field>
    </record>

    <record id="acc__view_salesperson_credit_limit_list" model="ir.ui.view">
        <field name="name">salesperson.credit.limit.list</field>
        <field name="model">salesperson.credit.limit</field>
        <field name="arch" type="xml">
            <list string="Salesperson Credit Limits" decoration-danger="utilization_percent &gt;= 100">
                <field name="salesperson_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="credit_limit" sum="Credit Limit"/>
                <field name="used_credit" sum="Used Credit"/>
                <field name="available_credit" sum="Available Credit" decoration-danger="available_credit &lt;= 0"/>
                <field name="utilization_percent" widget="percentage"/>
                <field name="active" optional="hide"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="acc__view_salesperson_credit_limit_form" model="ir.ui.view">
        <field name="name">salesperson.credit.limit.form</field>
        <field name="model">salesperson.credit.limit</field>
        <field name="arch" type="xml">
            <form string="Salesperson Credit Limit">
                <sheet>
                    <div class="oe_title">
                        <label for="salesperson_id" class="oe_edit_only"/>
                        <h1><field name="salesperson_id" options="{'no_create': True}"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id" options="{'no_create': True}"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="credit_limit"/>
                            <field name="active"/>
                        </group>
                        <group string="Current Usage">
                            <field name="used_credit" readonly="1"/>
                            <field name="available_credit" readonly="1"/>
                            <field name="utilization_percent" widget="percentage" readonly="1"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="status">
                        The used amount includes unpaid customer invoices assigned to this salesperson and the un-invoiced balance of confirmed sales orders. Payments release the limit when they reduce the accounting residual.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="acc__view_salesperson_credit_limit_search" model="ir.ui.view">
        <field name="name">salesperson.credit.limit.search</field>
        <field name="model">salesperson.credit.limit</field>
        <field name="arch" type="xml">
            <search string="Salesperson Credit Limits">
                <field name="salesperson_id"/>
                <field name="company_id"/>
                <filter name="active_limits" string="Active" domain="[('active', '=', True)]"/>
                <filter name="group_salesperson" string="Salesperson" context="{'group_by': 'salesperson_id'}"/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <record id="acc__action_salesperson_credit_limit" model="ir.actions.act_window">
        <field name="name">Salesperson Credit Limits</field>
        <field name="res_model">salesperson.credit.limit</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="acc__view_salesperson_credit_limit_search"/>
        <field name="context">{'search_default_active_limits': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a credit limit for a salesperson</p>
            <p>Confirmed sales orders are blocked when the salesperson's open exposure exceeds this limit.</p>
        </field>
    </record>

    <menuitem id="acc__menu_salesperson_credit_limit"
              name="Salesperson Credit Limits"
              parent="account.menu_finance_configuration"
              action="acc__action_salesperson_credit_limit"
              sequence="35"
              groups="sales_team.group_sale_manager,account.group_account_manager"/>
</odoo>
