<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="acc__working_file_check_treasury" model="account.working.file.template">
        <field name="sequence">10</field><field name="section">Treasury and financing</field>
        <field name="name">Review bank and cash balances</field>
        <field name="description">Agree balances to bank statements and supporting reconciliations.</field>
    </record>
