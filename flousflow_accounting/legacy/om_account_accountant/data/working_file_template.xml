        <field name="sequence">50</field><field name="section">Inventory</field>
        <field name="name">Review inventory valuation and count evidence</field>
    </record>
    <record id="acc__working_file_check_payables" model="account.working.file.template">
        <field name="sequence">60</field><field name="section">Purchases and payables</field>
        <field name="name">Review supplier balances and subsequent payments</field>
    </record>
