        <field name="sequence">70</field><field name="section">Purchases and payables</field>
        <field name="name">Review accrued expenses and cut-off</field>
    </record>
    <record id="acc__working_file_check_equity" model="account.working.file.template">
        <field name="sequence">80</field><field name="section">Equity and provisions</field>
        <field name="name">Review equity movements and provisions</field>
    </record>
    <record id="acc__working_file_check_expenses" model="account.working.file.template">
        <field name="sequence">90</field><field name="section">Operating expenses</field>
        <field name="name">Review material operating expenses</field>
    </record>
