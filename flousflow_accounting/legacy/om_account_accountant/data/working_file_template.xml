        <field name="description">Review aged receivables, material balances, and collectability evidence.</field>
    </record>
    <record id="acc__working_file_check_revenue" model="account.working.file.template">
        <field name="sequence">30</field><field name="section">Receivables and revenue</field>
        <field name="name">Review revenue recognition and cut-off</field>
