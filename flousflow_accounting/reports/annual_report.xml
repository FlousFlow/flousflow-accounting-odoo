<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_annual_report_record" model="ir.actions.report">
        <field name="name">Annual Report</field>
        <field name="model">flousflow.account.annual.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">flousflow_accounting.report_annual_report_record</field>
        <field name="paperformat_id" ref="paperformat_financial_statement"/>
        <field name="binding_model_id" ref="model_flousflow_account_annual_report"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_annual_report_record">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h1 t-field="doc.title"/>
                        <table class="table table-sm table-bordered">
                            <tbody>
                                <tr><th>Reporting Period</th><td><span t-field="doc.start_date"/> — <span t-field="doc.end_date"/></td></tr>
                                <tr><th>Company</th><td><span t-field="doc.company_id"/></td></tr>
                                <tr><th>Status</th><td><span t-field="doc.status"/></td></tr>
                                <tr><th>Responsibles</th><td><span t-out="', '.join(doc.responsible_user_ids.mapped('name'))"/></td></tr>
                                <tr t-if="doc.template_id"><th>Template</th><td><span t-field="doc.template_id"/></td></tr>
                            </tbody>
                        </table>
                        <div t-if="doc.content" class="mt-4" t-field="doc.content"/>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
