#. module: flousflow_accounting
#: model:mail.template,body_html:flousflow_accounting.fol__email_template_om_account_followup_default
msgid ""
"<div style=\"margin: 0; padding: 0; font-size: 14px;\">\n"
"    <p style=\"margin: 0 0 12px 0;\">Dear <t t-out=\"object.name or ''\"/>,</p>\n"
"    <p style=\"margin: 0 0 12px 0;\">According to our records, the invoices below are past their due date.</p>\n"
"    <p style=\"margin: 0 0 12px 0;\">If you have already paid them, please ignore this message. Otherwise, please settle them at your earliest convenience, and do not hesitate to contact us if you have any question.</p>\n"
"    <t t-out=\"object.get_followup_table_html()\"/>\n"
"    <p style=\"margin: 12px 0 0 0;\">\n"
"        Best regards,<br/>\n"
"        <t t-out=\"user.name or ''\"/><br/>\n"
"        <t t-out=\"env.company.name or ''\"/>\n"
"    </p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin: 0; padding: 0; font-size: 14px;\">\n"
"    <p style=\"margin: 0 0 12px 0;\">Vážený zákazníku <t t-out=\"object.name or ''\"/>,</p>\n"
"    <p style=\"margin: 0 0 12px 0;\">podle našich záznamů jsou níže uvedené faktury po splatnosti.</p>\n"
"    <p style=\"margin: 0 0 12px 0;\">Pokud jste je již uhradili, tuto zprávu prosím ignorujte. V opačném případě je prosím uhraďte co nejdříve a v případě jakýchkoli dotazů nás neváhejte kontaktovat.</p>\n"
"    <t t-out=\"object.get_followup_table_html()\"/>\n"
"    <p style=\"margin: 12px 0 0 0;\">\n"
"        S pozdravem<br/>\n"
"        <t t-out=\"user.name or ''\"/><br/>\n"
"        <t t-out=\"env.company.name or ''\"/>\n"
"    </p>\n"
"</div>\n"
"            "

