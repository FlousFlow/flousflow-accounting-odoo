"        <t t-out=\"env.company.name or ''\"/>\n"
"    </p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin: 0; padding: 0; font-size: 14px;\">\n"
"    <p style=\"margin: 0 0 12px 0;\">Szanowni Państwo (<t t-out=\"object.name or ''\"/>),</p>\n"
"    <p style=\"margin: 0 0 12px 0;\">Pomimo naszego poprzedniego przypomnienia poniższe faktury nadal pozostają niezapłacone.</p>\n"
"    <p style=\"margin: 0 0 12px 0;\">Prosimy o ich uregulowanie w ciągu 8 dni lub poinformowanie nas o ewentualnym problemie, abyśmy mogli go szybko rozwiązać.</p>\n"
"    <t t-out=\"object.get_followup_table_html()\"/>\n"
"    <p style=\"margin: 12px 0 0 0;\">\n"
"        Z poważaniem,<br/>\n"
"        <t t-out=\"user.name or ''\"/><br/>\n"
"        <t t-out=\"env.company.name or ''\"/>\n"
"    </p>\n"
"</div>\n"
"            "

#. module: flousflow_accounting
#: model:mail.template,body_html:flousflow_accounting.fol__email_template_om_account_followup_level2
msgid ""
"<div style=\"margin: 0; padding: 0; font-size: 14px;\">\n"
"    <p style=\"margin: 0 0 12px 0;\">Dear <t t-out=\"object.name or ''\"/>,</p>\n"
