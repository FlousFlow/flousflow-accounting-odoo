<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="flousflow_loan_list_view" model="ir.ui.view">
        <field name="name">flousflow.account.loan.list</field>
        <field name="model">flousflow.account.loan</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'closed'" decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="principal_amount" string="Amount Borrowed" sum="Principal"/>
                <field name="currency_id"/>
                <field name="start_date" string="Date"/>
                <field name="end_date"/>
                <field name="interest_account_id" string="Expense Account"/>
                <field name="outstanding_principal" string="Outstanding Balance" sum="Outstanding"/>
                <field name="liability_account_id" string="Loan Liability Account" optional="hide"/>
                <field name="description" optional="hide"/>
                <field name="lender_id" optional="hide"/>
                <field name="total_interest" sum="Interest" optional="hide"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="flousflow_loan_kanban_view" model="ir.ui.view">
        <field name="name">flousflow.account.loan.kanban</field>
        <field name="model">flousflow.account.loan</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="description"/>
                <field name="lender_id"/>
                <field name="principal_amount"/>
                <field name="currency_id"/>
                <field name="outstanding_principal"/>
                <field name="start_date"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between align-items-start">
                            <strong><field name="name"/></strong>
                            <field name="state" widget="label_selection"/>
                        </div>
                        <div class="text-muted"><field name="description"/></div>
                        <div class="mt-2"><field name="lender_id"/></div>
                        <div class="mt-2">
                            <span>Principal: </span><field name="principal_amount"/>
                        </div>
                        <div>
                            <span>Outstanding: </span><field name="outstanding_principal"/>
                        </div>
                        <div class="text-muted mt-2"><field name="start_date"/></div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="flousflow_loan_form_view" model="ir.ui.view">
        <field name="name">flousflow.account.loan.form</field>
        <field name="model">flousflow.account.loan</field>
        <field name="arch" type="xml">
            <form string="Loan">
                <header>
                    <button name="action_generate_schedule" type="object" string="Generate Schedule" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_confirm" type="object" string="Confirm &amp; Receive" class="btn-primary" invisible="state != 'draft'" groups="account.group_account_manager"/>
                    <button name="action_close" type="object" string="Close" invisible="state != 'running'" groups="account.group_account_manager"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state not in ('draft', 'running')" groups="account.group_account_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,running,closed,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(account.action_move_journal_line)d" type="action" class="oe_stat_button" icon="fa-book" invisible="not disbursement_move_id" context="{'search_default_id': disbursement_move_id}">
                            <field name="disbursement_move_id" string="Disbursement" widget="statinfo"/>
                        </button>
                    </div>
                    <div class="oe_title"><label for="name"/><h1><field name="name"/></h1><h2><field name="description" placeholder="Loan purpose"/></h2></div>
                    <group>
                        <group>
                            <field name="lender_id"/><field name="company_id" groups="base.group_multi_company"/>
                            <field name="asset_group_id"/>
                            <field name="currency_id"/><field name="principal_amount"/>
                            <field name="end_date" readonly="1"/>
                            <field name="annual_interest_rate"/><field name="computation_method"/>
                        </group>
                        <group>
                            <field name="start_date"/><field name="first_payment_date"/>
                            <field name="installment_count"/><field name="payment_frequency"/>
                            <field name="paid_installments" readonly="1"/><field name="outstanding_principal" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Amortization Schedule">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom" decoration-success="state == 'posted'" decoration-muted="state == 'reversed'">
                                    <field name="sequence"/><field name="date"/><field name="opening_balance"/>
                                    <field name="principal_amount" sum="Principal"/><field name="interest_amount" sum="Interest"/>
                                    <field name="payment_amount" sum="Payment"/><field name="closing_balance"/>
                                    <field name="state" widget="badge"/><field name="move_id" optional="show"/>
                                    <button name="action_post" type="object" string="Post" icon="fa-check" invisible="state != 'draft' or parent.state != 'running'" groups="account.group_account_user"/>
                                    <button name="action_reverse" type="object" string="Reverse" icon="fa-undo" invisible="state != 'posted'" groups="account.group_account_manager"/>
                                </list>
                            </field>
                        </page>
                        <page string="Accounting">
                            <group><group><field name="journal_id"/><field name="cash_account_id"/></group>
                            <group><field name="liability_account_id"/><field name="interest_account_id"/></group></group>
                            <field name="analytic_distribution" widget="analytic_distribution"/>
                        </page>
                        <page string="Totals"><group><field name="total_interest" readonly="1"/><field name="total_payable" readonly="1"/></group></page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="flousflow_loan_search_view" model="ir.ui.view">
        <field name="name">flousflow.account.loan.search</field><field name="model">flousflow.account.loan</field>
        <field name="arch" type="xml"><search><field name="name"/><field name="description"/><field name="lender_id"/>
            <filter name="running" string="Running" domain="[('state','=','running')]"/>
            <filter name="closed" string="Closed" domain="[('state','=','closed')]"/>
            <separator/>
            <filter name="group_lender" string="Lender" context="{'group_by':'lender_id'}"/><filter name="group_state" string="Status" context="{'group_by':'state'}"/>
        </search></field>
    </record>
    <record id="flousflow_loan_pivot_view" model="ir.ui.view"><field name="name">flousflow.account.loan.pivot</field><field name="model">flousflow.account.loan</field><field name="arch" type="xml"><pivot string="Loan Analysis"><field name="lender_id" type="row"/><field name="state" type="col"/><field name="principal_amount" type="measure"/><field name="total_interest" type="measure"/><field name="outstanding_principal" type="measure"/></pivot></field></record>
    <record id="flousflow_loan_graph_view" model="ir.ui.view"><field name="name">flousflow.account.loan.graph</field><field name="model">flousflow.account.loan</field><field name="arch" type="xml"><graph string="Loan Analysis"><field name="lender_id"/><field name="outstanding_principal" type="measure"/></graph></field></record>
    <!-- Enterprise's Loans Analysis destination is installment-line based.
         Expose the equivalent FlousFlow schedule rows as a dedicated action. -->
    <record id="flousflow_loan_line_list_view" model="ir.ui.view">
        <field name="name">flousflow.account.loan.line.list</field>
        <field name="model">flousflow.account.loan.line</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <field name="loan_id"/>
                <field name="loan_date" optional="show"/>
                <field name="loan_asset_group_id" optional="show"/>
                <field name="date"/>
                <field name="principal_amount" string="Principal" sum="Principal" optional="show"/>
                <field name="interest_amount" string="Interest" sum="Interest" optional="show"/>
                <field name="payment_amount" string="Payment" sum="Payment" optional="show"/>
                <field name="long_term_theoretical_balance" string="Long-Term" sum="Long-Term" optional="show"/>
                <field name="short_term_theoretical_balance" string="Short-Term" sum="Short-Term" optional="show"/>
                <field name="closing_balance" string="Outstanding Balance" sum="Outstanding Balance" optional="hide"/>
                <field name="state" string="Status" widget="badge" optional="hide"/>
                <field name="move_id" string="Generated Entries" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="flousflow_loan_line_pivot_view" model="ir.ui.view">
        <field name="name">flousflow.account.loan.line.pivot</field>
        <field name="model">flousflow.account.loan.line</field>
        <field name="arch" type="xml">
            <pivot string="Loans Analysis">
                <field name="date" type="col" interval="year"/>
                <field name="loan_id" type="row"/>
                <field name="principal_amount" type="measure" string="Principal"/>
                <field name="interest_amount" type="measure" string="Interest"/>
                <field name="payment_amount" type="measure" string="Payment"/>
            </pivot>
        </field>
    </record>
    <record id="flousflow_loan_line_form_view" model="ir.ui.view">
        <field name="name">flousflow.account.loan.line.form</field>
        <field name="model">flousflow.account.loan.line</field>
        <field name="arch" type="xml">
            <form string="Loan Installment" create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <group>
                            <field name="loan_id"/>
                            <field name="loan_date"/>
                            <field name="loan_asset_group_id"/>
                            <field name="date"/>
                            <field name="state"/>
                        </group>
                        <group>
                            <field name="opening_balance"/>
                            <field name="principal_amount"/>
                            <field name="interest_amount"/>
                            <field name="payment_amount"/>
                            <field name="closing_balance"/>
                            <field name="long_term_theoretical_balance"/>
                            <field name="short_term_theoretical_balance"/>
                            <field name="move_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="flousflow_loan_line_search_view" model="ir.ui.view">
        <field name="name">flousflow.account.loan.line.search</field>
        <field name="model">flousflow.account.loan.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="loan_name" string="Loan" filter_domain="[('loan_name', 'ilike', self)]"/>
                <filter name="current" string="Current"
                        domain="[('loan_state', 'in', ('draft', 'running'))]"
                        help="Draft and running loans"/>
                <filter name="closed" string="Closed"
                        domain="[('loan_state', '=', 'closed')]"/>
                <field name="date"/>
                <filter name="loan_line_date" string="Loan Date" date="date"/>
                <filter name="scheduled" string="Scheduled" domain="[('state', '=', 'draft')]"/>
                <filter name="posted" string="Posted" domain="[('state', '=', 'posted')]"/>
                <filter name="reversed" string="Reversed" domain="[('state', '=', 'reversed')]"/>
                <separator/>
                <group>
                    <filter name="group_by_loan" string="Loan" context="{'group_by': 'loan_id'}"/>
                    <filter name="group_by_loan_line_date" string="Loan Date" context="{'group_by': 'date'}"/>
                    <filter name="group_by_asset_group" string="Asset Group" context="{'group_by': 'loan_asset_group_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="flousflow_loan_action" model="ir.actions.act_window"><field name="name">Loans</field><field name="res_model">flousflow.account.loan</field><field name="view_mode">list,form,kanban,pivot,graph</field><field name="search_view_id" ref="flousflow_loan_search_view"/></record>
    <record id="flousflow_loan_analysis_action" model="ir.actions.act_window">
        <field name="name">Loans Analysis</field>
        <field name="res_model">flousflow.account.loan.line</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="flousflow_loan_line_search_view"/>
        <field name="context" eval="{'search_default_current': 1}"/>
    </record>
    <record id="flousflow_loan_analysis_pivot_action_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="flousflow_loan_line_pivot_view"/>
        <field name="act_window_id" ref="flousflow_loan_analysis_action"/>
    </record>
    <record id="flousflow_loan_analysis_list_action_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="flousflow_loan_line_list_view"/>
        <field name="act_window_id" ref="flousflow_loan_analysis_action"/>
    </record>
    <record id="flousflow_loan_analysis_form_action_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="3"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="flousflow_loan_line_form_view"/>
        <field name="act_window_id" ref="flousflow_loan_analysis_action"/>
    </record>
</odoo>
