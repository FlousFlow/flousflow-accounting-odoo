<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_account_app_icon" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.account.app.icon</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="attributes">
                <attribute name="logo">/flousflow_accounting/static/legacy/om_account_accountant/description/icon.png</attribute>
            </xpath>
        </field>
    </record>

    <!-- Keep the legacy report engines available to internal callers, but remove
         obsolete shortcuts from the reports navigation after all menu data loads. -->
    <record id="apr__menu_account_report_financial" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

    <record id="account.menu_action_analytic_reporting" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
</odoo>
