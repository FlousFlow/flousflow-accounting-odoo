<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_account_app_icon" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.account.app.icon</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="attributes">
                <attribute name="logo">/flousflow_accounting/static/legacy/om_account_accountant/description/icon.png</attribute>
            </xpath>
        </field>
    </record>
</odoo>
