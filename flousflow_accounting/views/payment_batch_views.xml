<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="flousflow_payment_batch_view_list" model="ir.ui.view">
        <field name="name">flousflow.account.payment.batch.list</field>
        <field name="model">flousflow.account.payment.batch</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'posted'" decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="date"/>
                <field name="journal_id"/>
                <field name="payment_type"/>
                <field name="payment_count"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="amount_total" sum="Total"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="flousflow_payment_batch_view_form" model="ir.ui.view">
        <field name="name">flousflow.account.payment.batch.form</field>
        <field name="model">flousflow.account.payment.batch</field>
        <field name="arch" type="xml">
            <form string="Payment Batch">
                <header>
                    <button name="action_submit" string="Submit" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve" type="object"
                            class="btn-primary" groups="account.group_account_manager"
                            invisible="state != 'submitted'"/>
                    <button name="action_post" string="Post Payments" type="object"
                            class="btn-primary" groups="account.group_account_manager"
                            invisible="state != 'approved'"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state not in ('draft', 'submitted', 'approved')"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved,posted"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company"
                                   readonly="state != 'draft'"/>
                            <field name="journal_id" readonly="state != 'draft'"/>
                            <field name="payment_type" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="currency_id"/>
                            <field name="payment_count"/>
                            <field name="amount_total"/>
                            <field name="submitted_by_id" invisible="not submitted_by_id"/>
                            <field name="approved_by_id" invisible="not approved_by_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Payments">
                            <field name="payment_ids" readonly="state != 'draft'"
                                   context="{'default_journal_id': journal_id, 'default_payment_type': payment_type}">
                                <list create="0" edit="0" delete="0">
                                    <field name="date"/>
                                    <field name="name"/>
                                    <field name="partner_id"/>
                                    <field name="payment_type"/>
                                    <field name="currency_id"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Review">
                            <group>
                                <field name="submitted_at"/>
                                <field name="approved_at"/>
                            </group>
                            <field name="note" placeholder="Internal review notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter>
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </chatter>
            </form>
        </field>
    </record>

    <record id="flousflow_payment_batch_action" model="ir.actions.act_window">
        <field name="name">Payment Batches</field>
        <field name="res_model">flousflow.account.payment.batch</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
