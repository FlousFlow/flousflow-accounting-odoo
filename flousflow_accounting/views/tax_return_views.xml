<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="flousflow_tax_return_view_list" model="ir.ui.view">
        <field name="name">flousflow.account.tax.return.list</field><field name="model">flousflow.account.tax.return</field>
        <field name="arch" type="xml"><list decoration-success="state == 'closed'" decoration-warning="state == 'review'"><field name="name"/><field name="company_id" groups="base.group_multi_company"/><field name="fiscal_country_id"/><field name="date_from"/><field name="date_to"/><field name="date_deadline"/><field name="days_to_deadline" optional="hide"/><field name="date_submission" optional="hide"/><field name="date_lock" optional="hide"/><field name="reviewer_id"/><field name="total_amount"/><field name="draft_tax_move_count"/><field name="state" widget="badge"/></list></field>
    </record>
    <record id="flousflow_tax_return_view_kanban" model="ir.ui.view">
        <field name="name">flousflow.account.tax.return.kanban</field>
        <field name="model">flousflow.account.tax.return</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="company_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="date_deadline"/>
                <field name="days_to_deadline"/>
                <field name="fiscal_country_id"/>
                <field name="reviewer_id"/>
                <field name="total_amount"/>
                <field name="currency_id"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="d-flex justify-content-between align-items-start">
                                <strong><field name="name"/></strong>
                                <field name="state" widget="badge"/>
                            </div>
                            <div class="text-muted mt-2">
                                <field name="date_from"/> — <field name="date_to"/>
                            </div>
                            <div t-if="record.date_deadline.raw_value" class="mt-2">
                                <span>Filing deadline: </span><field name="date_deadline"/>
                                <span class="text-muted"> (<field name="days_to_deadline"/> days)</span>
                            </div>
                            <div><field name="fiscal_country_id"/></div>
                            <div class="mt-2">
                                <span>Reviewer: </span><field name="reviewer_id"/>
                            </div>
                            <div class="mt-2">
                                <span>Total: </span><field name="total_amount" widget="monetary"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="flousflow_tax_return_view_calendar" model="ir.ui.view">
        <field name="name">flousflow.account.tax.return.calendar</field>
        <field name="model">flousflow.account.tax.return</field>
        <field name="arch" type="xml">
            <calendar string="Tax Returns" date_start="date_from" date_stop="date_to"
                      color="state" mode="month">
                <field name="name"/>
                <field name="reviewer_id"/>
                <field name="total_amount"/>
            </calendar>
        </field>
    </record>
    <record id="flousflow_tax_return_view_search" model="ir.ui.view">
        <field name="name">flousflow.account.tax.return.search</field>
        <field name="model">flousflow.account.tax.return</field>
        <field name="arch" type="xml">
            <search string="Tax Returns">
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="fiscal_country_id"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="review" string="In Review" domain="[('state', '=', 'review')]"/>
                <filter name="approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <filter name="closed" string="Closed" domain="[('state', '=', 'closed')]"/>
                <separator/>
                <filter name="deadline" string="Filing Deadline" date="date_deadline"/>
                <filter name="submission_date" string="Review Submission Date" date="date_submission"/>
                <group>
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="flousflow_tax_return_view_form" model="ir.ui.view">
        <field name="name">flousflow.account.tax.return.form</field><field name="model">flousflow.account.tax.return</field>
        <field name="arch" type="xml">
            <form string="Tax Return Review"><header>
                <button name="action_prepare" type="object" string="Prepare from Tax Grids" class="btn-primary" invisible="state != 'draft'"/>
                <button name="action_submit" type="object" string="Submit for Review" class="btn-primary" invisible="state != 'draft'"/>
                <button name="action_approve" type="object" string="Approve" class="btn-primary" groups="account.group_account_manager" invisible="state != 'review'"/>
                <button name="action_close" type="object" string="Close Tax Period" class="btn-primary" groups="account.group_account_manager" invisible="state != 'approved'" confirm="This applies the standard tax lock date. Continue?"/>
                <field name="state" widget="statusbar" statusbar_visible="draft,review,approved,closed"/>
            </header><sheet>
                <div class="oe_title"><label for="name"/><h1><field name="name" readonly="state != 'draft'"/></h1></div>
                <group><group><field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/><field name="fiscal_country_id"/><field name="date_from" readonly="state != 'draft'"/><field name="date_to" readonly="state != 'draft'"/><field name="date_deadline" readonly="state in ('approved', 'closed')"/><field name="days_to_deadline"/></group><group><field name="responsible_id"/><field name="reviewer_id" readonly="state != 'draft'"/><field name="date_submission"/><field name="date_lock"/><field name="draft_tax_move_count"/><field name="total_amount"/></group></group>
                <notebook><page string="Localization Tax Grids"><field name="line_ids" readonly="1"><list><field name="tag_id"/><field name="amount" sum="Total"/></list></field></page>
                <page string="Evidence &amp; Review"><field name="working_file_ids" widget="many2many_tags" readonly="state == 'closed'"/><field name="notes" placeholder="Review evidence, reconciliations and filing reference..." readonly="state == 'closed'"/><group invisible="state not in ('approved', 'closed')"><field name="approved_by_id"/><field name="approved_date"/><field name="closed_by_id" invisible="not closed_by_id"/><field name="closed_date" invisible="not closed_date"/></group></page></notebook>
            </sheet><chatter/></form>
        </field>
    </record>
    <record id="flousflow_tax_return_action" model="ir.actions.act_window"><field name="name">Tax Returns</field><field name="res_model">flousflow.account.tax.return</field><field name="view_mode">kanban,calendar,list,form</field><field name="search_view_id" ref="flousflow_tax_return_view_search"/></record>
</odoo>
