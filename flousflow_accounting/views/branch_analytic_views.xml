<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ff_view_move_form_branch_analytic" model="ir.ui.view">
        <field name="name">account.move.form.flousflow.branch.analytic</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@id='header_right_group']" position="inside">
                <label for="analytic_account_id" string="Branch / Analytic Account"
                       style="font-weight:bold;"
                       invisible="move_type not in ('out_invoice', 'out_refund')"/>
                <field name="analytic_account_id" nolabel="1"
                       options="{'no_create': True}"
                       domain="[('company_id', 'in', [company_id, False])]"
                       invisible="move_type not in ('out_invoice', 'out_refund')"
                       readonly="state != 'draft'"/>
            </xpath>
        </field>
    </record>

    <record id="ff_view_pos_config_form_branch_analytic" model="ir.ui.view">
        <field name="name">pos.config.form.flousflow.branch.analytic</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='configuration']" position="after">
                <page string="Branch Analytics" name="flousflow_branch_analytic">
                    <group>
                        <field name="analytic_account_id" options="{'no_create': True}"
                               domain="[('company_id', 'in', [company_id, False])]"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="ff_view_order_form_branch_analytic" model="ir.ui.view">
        <field name="name">sale.order.form.flousflow.branch.analytic</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='other_information']//group[@name='sale_info']" position="inside">
                <field name="analytic_account_id" string="Branch / Analytic Account"
                       options="{'no_create': True}"
                       domain="[('company_id', 'in', [company_id, False])]"
                       readonly="state == 'cancel' or locked"/>
            </xpath>
        </field>
    </record>

    <record id="ff_res_config_settings_view_form_branch_analytic" model="ir.ui.view">
        <field name="name">res.config.settings.flousflow.branch.analytic</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='analytic']" position="inside">
                <setting id="ff_branch_analytic_require_pos"
                         string="Require Analytic Account on POS" company_dependent="1"
                         groups="account.group_account_user">
                    <field name="branch_analytic_require_pos"/>
                </setting>
                <setting id="ff_branch_analytic_require_invoice"
                         string="Require Analytic Account on Customer Invoices" company_dependent="1"
                         groups="account.group_account_user">
                    <field name="branch_analytic_require_invoice"/>
                </setting>
                <setting id="ff_branch_analytic_require_sale"
                         string="Require Analytic Account on Sales Orders" company_dependent="1"
                         groups="account.group_account_user">
                    <field name="branch_analytic_require_sale"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
