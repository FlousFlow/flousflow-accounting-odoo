<?xml version="1.0" encoding="utf-8"?>
<!-- Part of FlousFlow Accounting -->
<odoo>
    <!-- Reuse the standard Account application instead of creating a second,
         overlapping accounting root. -->
    <record id="account.menu_finance" model="ir.ui.menu">
        <field name="name">Accounting</field>
        <field name="web_icon">flousflow_accounting,static/description/accounting_icon_v2.png</field>
        <field name="sequence">11</field>
    </record>

    <!-- Keep the standard Odoo Journal Board as the Accounting dashboard. -->
    <record id="account.menu_board_journal_1" model="ir.ui.menu">
        <field name="action" ref="account.open_account_journal_dashboard_kanban"/>
    </record>

    <!-- Keep the native Odoo 19 navigation hierarchy. These records restore
         standard parents in databases upgraded from earlier FlousFlow builds. -->
    <record id="account.menu_action_move_journal_line_form" model="ir.ui.menu">
        <field name="parent_id" ref="account.account_transactions_menu"/>
        <field name="sequence">1</field>
    </record>
    <record id="account.menu_action_account_moves_all" model="ir.ui.menu">
        <field name="parent_id" ref="account.account_audit_control_menu"/>
        <field name="sequence">6</field>
    </record>
    <record id="account.menu_action_account_form" model="ir.ui.menu">
        <field name="parent_id" ref="account.account_account_menu"/>
        <field name="sequence">1</field>
    </record>

    <!-- Kept inactive so upgrades from versions <= 19.0.8 do not leave the
         former duplicate root visible. -->
    <record id="menu_flousflow_accounting_root" model="ir.ui.menu">
        <field name="name">Legacy FlousFlow Accounting Root</field>
        <field name="active" eval="False"/>
        <field name="sequence">999</field>
    </record>

    <!-- Accounting / Closing and asset operations -->
    <menuitem id="menu_flousflow_accounting_period_closing"
              name="Period Closing"
              parent="account.account_closing_menu"
              action="flousflow_period_close_action"
              sequence="5"/>
    <menuitem id="menu_flousflow_accounting_lock_dates"
              name="Lock Dates…"
              parent="account.account_closing_menu"
              action="flousflow_account_lock_date_action"
              groups="account.group_account_manager"
              sequence="20"/>
    <menuitem id="menu_flousflow_accounting_assets"
              name="Assets &amp; Liabilities"
              parent="account.menu_finance_entries"
              sequence="30">
        <menuitem id="menu_flousflow_accounting_asset_list"
                  name="Assets" action="flousflow_asset_action" sequence="10"/>
        <menuitem id="menu_flousflow_accounting_loans"
                  name="Loans" action="flousflow_loan_action" sequence="20"/>
    </menuitem>

    <!-- Review -->
    <menuitem id="menu_flousflow_accounting_working_files"
              name="Working Files"
              parent="account.account_audit_menu"
              action="flousflow_working_file_action"
              sequence="20"/>
    <menuitem id="menu_flousflow_accounting_regularization"
              name="Regularization Entries"
              parent="account.account_audit_menu"
              sequence="30">
        <menuitem id="menu_flousflow_accounting_currencies"
                  name="Currencies" action="flousflow_revaluation_action"/>
        <menuitem id="menu_flousflow_deferred_revenue"
                  name="Deferred Revenues" action="flousflow_deferred_revenue_action"/>
        <menuitem id="menu_flousflow_deferred_expense"
                  name="Deferred Expenses" action="flousflow_deferred_expense_action"/>
    </menuitem>
    <menuitem id="menu_flousflow_accounting_review_inventory"
              name="Inventory"
              parent="account.account_audit_menu"
              sequence="40">
        <menuitem id="menu_flousflow_accounting_depreciation_schedule"
                  name="Depreciation Schedule"
                  action="flousflow_asset_dep_line_action" sequence="20"/>
        <menuitem id="menu_flousflow_accounting_accrual_review"
                  name="Accrual Review"
                  action="flousflow_accrual_review_action" sequence="30"/>
    </menuitem>

    <!-- Reporting: extend the standard Odoo report folders. -->
    <menuitem id="menu_flousflow_accounting_pnl"
              name="Profit &amp; Loss"
              parent="account.account_reports_legal_statements_menu"
              action="flousflow_account_report_pnl_action" sequence="10"/>
    <menuitem id="menu_flousflow_accounting_balance_sheet"
              name="Balance Sheet"
              parent="account.account_reports_legal_statements_menu"
              action="flousflow_account_report_balance_action" sequence="20"/>
    <menuitem id="menu_flousflow_accounting_cash_flow"
              name="Cash Flow Statement"
              parent="account.account_reports_legal_statements_menu"
              action="flousflow_account_report_cash_flow_action" sequence="30"/>

    <menuitem id="menu_flousflow_ledger_reports"
              name="Ledgers" parent="account.menu_finance_reports" sequence="2">
        <menuitem id="menu_flousflow_accounting_trial_balance"
                  name="Trial Balance" action="flousflow_account_report_trial_balance_action"/>
        <menuitem id="menu_flousflow_accounting_general_ledger"
                  name="General Ledger" action="flousflow_account_report_gl_action"/>
        <menuitem id="menu_flousflow_accounting_account_statement"
                  name="Account Statement" action="flousflow_account_report_account_statement_action"/>
    </menuitem>
    <menuitem id="menu_flousflow_accounting_journal_audit"
              name="Journal Audit"
              parent="account.account_audit_control_menu"
              action="flousflow_account_report_journal_audit_action"
              sequence="20"/>
    <menuitem id="menu_flousflow_accounting_saved_report_filters"
              name="Saved Report Filters"
              parent="account.menu_finance_reports"
              action="flousflow_account_report_preset_action" sequence="90"/>
    <menuitem id="menu_flousflow_accounting_executive_summary"
              name="Executive Summary"
              parent="account.account_reports_management_menu"
              action="flousflow_account_report_executive_action" sequence="30"/>

    <menuitem id="menu_flousflow_accounting_partner_ledger"
              name="Partner Ledger"
              parent="account.account_reports_partners_reports_menu"
              action="flousflow_account_report_partner_ledger_action" sequence="10"/>
    <menuitem id="menu_flousflow_accounting_customer_statement"
              name="Customer Statement"
              parent="account.account_reports_partners_reports_menu"
              action="flousflow_account_report_customer_statement_action" sequence="20"/>
    <menuitem id="menu_flousflow_accounting_vendor_statement"
              name="Vendor Statement"
              parent="account.account_reports_partners_reports_menu"
              action="flousflow_account_report_vendor_statement_action" sequence="30"/>
    <menuitem id="menu_flousflow_accounting_aged_receivable"
              name="Aged Receivable"
              parent="account.account_reports_partners_reports_menu"
              action="flousflow_account_report_aged_rec_action" sequence="40"/>
    <menuitem id="menu_flousflow_accounting_aged_payable"
              name="Aged Payable"
              parent="account.account_reports_partners_reports_menu"
              action="flousflow_account_report_aged_pay_action" sequence="50"/>
    <menuitem id="menu_flousflow_accounting_tax_report"
              name="Tax Report"
              parent="account.account_reports_taxes_and_fiscal_menu"
              action="flousflow_account_report_tax_action" sequence="10"/>
    <menuitem id="menu_flousflow_accounting_tax_returns"
              name="Tax Return Reviews"
              parent="account.account_reports_taxes_and_fiscal_menu"
              action="flousflow_tax_return_action"
              groups="account.group_account_user" sequence="20"/>

    <!-- Standalone business areas unique to this suite. -->
    <menuitem id="menu_flousflow_accounting_followup"
              name="Follow-up" parent="account.menu_finance_receivables" sequence="20">
        <menuitem id="menu_flousflow_accounting_followup_report"
                  name="Follow-up Report" action="flousflow_followup_partner_action"/>
        <menuitem id="menu_flousflow_accounting_followup_run"
                  name="Run Follow-up" action="flousflow_followup_wizard_action"/>
        <menuitem id="menu_flousflow_accounting_followup_history"
                  name="Follow-up History" action="flousflow_followup_history_action"/>
        <menuitem id="menu_flousflow_accounting_payment_promises"
                  name="Promises to Pay" action="flousflow_payment_promise_action"/>
    </menuitem>
    <menuitem id="menu_flousflow_accounting_recurring"
              name="Recurring Payments" parent="account.account_transactions_menu"
              action="flousflow_recurring_action" sequence="30"/>
    <menuitem id="menu_flousflow_accounting_payment_batches"
              name="Payment Batches" parent="account.account_transactions_menu"
              action="flousflow_payment_batch_action" sequence="25"/>
    <menuitem id="menu_flousflow_accounting_pos_sessions"
              name="Point of Sale Sessions"
              parent="account.account_transactions_menu"
              action="point_of_sale.action_pos_session"
              groups="point_of_sale.group_pos_user" sequence="26"/>

    <!-- Configuration additions only; standard accounting configuration is reused. -->
    <menuitem id="menu_flousflow_accounting_fiscal_years"
              name="Fiscal Years" parent="account.account_account_menu"
              action="flousflow_fiscal_year_action" sequence="20"/>
    <menuitem id="menu_flousflow_accounting_asset_categories"
              name="Asset Models" parent="account.account_account_menu"
              action="flousflow_asset_category_action" sequence="21"/>
    <menuitem id="menu_flousflow_accounting_asset_groups"
              name="Asset Groups" parent="account.account_account_menu"
              action="flousflow_asset_group_action" sequence="22"/>
    <menuitem id="menu_flousflow_accounting_budgets"
              name="Financial Budgets" parent="account.account_account_menu"
              action="flousflow_budget_action" sequence="23"/>
    <menuitem id="menu_flousflow_accounting_followup_levels"
              name="Follow-up Levels" parent="account.account_invoicing_menu"
              action="flousflow_followup_action" sequence="30"/>
    <menuitem id="menu_flousflow_accounting_report_templates"
              name="Report Templates"
              parent="account.menu_finance_configuration"
              action="flousflow_report_template_action"
              groups="account.group_account_manager" sequence="50"/>
    <menuitem id="menu_flousflow_accounting_bank_statements"
              name="Bank Statements"
              parent="account.account_transactions_menu"
              action="account.action_bank_statement_tree" sequence="20"/>
    <menuitem id="menu_flousflow_accounting_manual_bank_reconciliation"
              name="Bank Reconciliation"
              parent="account.account_transactions_menu"
              action="action_flousflow_manual_bank_reconciliation"
              groups="account.group_account_user" sequence="21"/>
    <menuitem id="menu_flousflow_accounting_reconciliation_models"
              name="Reconciliation Models"
              parent="account.menu_finance_configuration"
              action="account.action_account_reconcile_model" sequence="61"/>
</odoo>
