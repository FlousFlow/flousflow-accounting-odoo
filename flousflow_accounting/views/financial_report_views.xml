<?xml version="1.0" encoding="utf-8"?>
<!-- Part of FlousFlow Accounting -->
<odoo>
    <record id="flousflow_report_template_action" model="ir.actions.act_window">
        <field name="name">Financial Report Templates</field>
        <field name="res_model">flousflow.account.report.template</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="flousflow_report_template_view_list" model="ir.ui.view">
        <field name="name">flousflow.account.report.template.list</field>
        <field name="model">flousflow.account.report.template</field>
        <field name="arch" type="xml">
            <list string="Report Templates">
                <field name="name"/>
                <field name="code"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="flousflow_report_template_view_form" model="ir.ui.view">
        <field name="name">flousflow.account.report.template.form</field>
        <field name="model">flousflow.account.report.template</field>
        <field name="arch" type="xml">
            <form string="Report Template">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="company_id"
                                   help="Leave empty to share this template across all companies."/>
                        </group>
                    </group>
                    <group string="Lines">
                        <field name="line_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="parent_id"/>
                                <field name="name"/>
                                <field name="code"/>
                                <field name="sign"/>
                                <field name="account_types"/>
                                <field name="account_ids" widget="many2many_tags"/>
                                <field name="formula"/>
                                <field name="date_scope" optional="show"/>
                                <field name="hide_in_report" optional="hide"/>
                                <field name="is_section"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
