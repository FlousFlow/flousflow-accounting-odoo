<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="flousflow_open_item_reconciliation_view_list" model="ir.ui.view">
        <field name="name">account.move.line.flousflow.open.item.reconciliation.list</field>
        <field name="model">account.move.line</field>
        <field name="arch" type="xml">
            <list string="Journal Items to Reconcile" create="false" edit="false"
                  default_order="date_maturity, date, id">
                <header>
                    <button name="action_flousflow_reconcile_open_items"
                            type="object" string="Reconcile Selected"
                            class="btn-primary" groups="account.group_account_user"/>
                </header>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="account_id"/>
                <field name="partner_id"/>
                <field name="date"/>
                <field name="date_maturity" optional="show"/>
                <field name="move_name" string="Journal Entry"/>
                <field name="name" string="Label" optional="show"/>
                <field name="debit" sum="Total Debit"/>
                <field name="credit" sum="Total Credit"/>
                <field name="amount_residual" string="Residual" sum="Total Residual"/>
                <field name="amount_residual_currency" string="Residual in Currency"
                       groups="base.group_multi_currency" optional="hide"/>
                <field name="currency_id" groups="base.group_multi_currency" optional="hide"/>
                <field name="parent_state" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="flousflow_open_item_reconciliation_action" model="ir.actions.act_window">
        <field name="name">Reconcile</field>
        <field name="res_model">account.move.line</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="flousflow_open_item_reconciliation_view_list"/>
        <field name="search_view_id" ref="account.view_account_move_line_filter"/>
        <field name="domain">[
            ('display_type', 'not in', ('line_section', 'line_subsection', 'line_note')),
            ('account_id.reconcile', '=', True),
            ('full_reconcile_id', '=', False),
            ('parent_state', '!=', 'cancel')
        ]</field>
        <field name="context">{
            'journal_type': 'general',
            'search_default_posted': 1,
            'search_default_unreconciled': 1,
            'search_default_group_by_account': 1,
            'search_default_group_by_partner': 1
        }</field>
    </record>
</odoo>
