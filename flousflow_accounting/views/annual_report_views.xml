<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="flousflow_annual_report_template_list" model="ir.ui.view">
        <field name="name">flousflow.account.annual.report.template.list</field>
        <field name="model">flousflow.account.annual.report.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="description" optional="hide"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="flousflow_annual_report_template_form" model="ir.ui.view">
        <field name="name">flousflow.account.annual.report.template.form</field>
        <field name="model">flousflow.account.annual.report.template</field>
        <field name="arch" type="xml">
            <form string="Annual Report Template">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="active"/>
                    </group>
                    <field name="description"/>
                    <field name="content" widget="html"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="flousflow_annual_report_template_search" model="ir.ui.view">
        <field name="name">flousflow.account.annual.report.template.search</field>
        <field name="model">flousflow.account.annual.report.template</field>
        <field name="arch" type="xml">
            <search string="Annual Report Templates">
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <group>
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>
    <record id="flousflow_annual_report_template_action" model="ir.actions.act_window">
        <field name="name">Annual Report Templates</field>
        <field name="res_model">flousflow.account.annual.report.template</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="flousflow_annual_report_template_search"/>
    </record>

    <record id="flousflow_annual_report_list" model="ir.ui.view">
        <field name="name">flousflow.account.annual.report.list</field>
        <field name="model">flousflow.account.annual.report</field>
        <field name="arch" type="xml">
            <list decoration-success="status == 'done'" decoration-warning="status == 'in_progress'">
                <field name="title"/>
                <field name="status" widget="badge"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="responsible_user_ids" widget="many2many_tags"/>
                <field name="template_id" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="flousflow_annual_report_kanban" model="ir.ui.view">
        <field name="name">flousflow.account.annual.report.kanban</field>
        <field name="model">flousflow.account.annual.report</field>
        <field name="arch" type="xml">
            <kanban default_group_by="status" class="o_kanban_small_column">
                <field name="title"/>
                <field name="status"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="company_id"/>
                <field name="responsible_user_ids"/>
                <field name="template_id"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="d-flex justify-content-between align-items-start">
                                <strong><field name="title"/></strong>
                                <field name="status" widget="badge"/>
                            </div>
                            <div class="text-muted mt-2">
                                <field name="start_date"/> — <field name="end_date"/>
                            </div>
                            <div><field name="company_id"/></div>
                            <div class="mt-2"><field name="responsible_user_ids" widget="many2many_tags"/></div>
                            <div t-if="record.template_id.raw_value" class="text-muted mt-2">
                                <field name="template_id"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="flousflow_annual_report_form" model="ir.ui.view">
        <field name="name">flousflow.account.annual.report.form</field>
        <field name="model">flousflow.account.annual.report</field>
        <field name="arch" type="xml">
            <form string="Annual Report">
                <header>
                    <button name="action_start" type="object" string="Start Report" class="btn-primary" invisible="status != 'draft'"/>
                    <button name="action_complete" type="object" string="Mark Completed" class="btn-primary" invisible="status != 'in_progress'"/>
                    <button name="action_reset_to_draft" type="object" string="Reopen" groups="account.group_account_manager" invisible="status != 'done'"/>
                    <button name="action_generate_financial_statements" type="object" string="Generate Financial Statements" invisible="status == 'draft'"/>
                    <button name="action_print_report" type="object" string="Print Report"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_title"><label for="title"/><h1><field name="title" readonly="status == 'done'"/></h1></div>
                    <group>
                        <group>
                            <field name="start_date" readonly="status == 'done'"/>
                            <field name="end_date" readonly="status == 'done'"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="status == 'done'"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="responsible_user_ids" widget="many2many_tags" readonly="status == 'done'"/>
                            <field name="template_id" readonly="status == 'done'" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Report Content"><field name="content" widget="html" readonly="status == 'done'"/></page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="flousflow_annual_report_search" model="ir.ui.view">
        <field name="name">flousflow.account.annual.report.search</field>
        <field name="model">flousflow.account.annual.report</field>
        <field name="arch" type="xml">
            <search string="Annual Reports">
                <field name="title"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="responsible_user_ids"/>
                <filter name="my_reports" string="My Reports" domain="[('responsible_user_ids', 'in', [uid])]"/>
                <filter name="in_progress" string="In Progress" domain="[('status', '=', 'in_progress')]"/>
                <filter name="completed" string="Completed" domain="[('status', '=', 'done')]"/>
                <separator/>
                <filter name="report_period" string="Report Period" date="start_date"/>
                <group>
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>
    <record id="flousflow_annual_report_action" model="ir.actions.act_window">
        <field name="name">Annual Reports</field>
        <field name="res_model">flousflow.account.annual.report</field>
        <field name="view_mode">kanban,list</field>
        <field name="search_view_id" ref="flousflow_annual_report_search"/>
    </record>
</odoo>
