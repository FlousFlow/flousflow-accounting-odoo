<?xml version="1.0" encoding="utf-8"?>
<!-- Part of FlousFlow Accounting -->
<odoo>
    <record id="flousflow_fiscal_year_action" model="ir.actions.act_window">
        <field name="name">Fiscal Years</field>
        <field name="res_model">flousflow.account.fiscal.year</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="flousflow_fiscal_year_view_list" model="ir.ui.view">
        <field name="name">flousflow.account.fiscal.year.list</field>
        <field name="model">flousflow.account.fiscal.year</field>
        <field name="arch" type="xml">
            <list string="Fiscal Years">
                <field name="name"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="flousflow_fiscal_year_view_form" model="ir.ui.view">
        <field name="name">flousflow.account.fiscal.year.form</field>
        <field name="model">flousflow.account.fiscal.year</field>
        <field name="arch" type="xml">
            <form string="Fiscal Year">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
