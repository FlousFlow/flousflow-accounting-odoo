<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="flousflow_period_close_view_form_pos" model="ir.ui.view">
        <field name="name">flousflow.account.period.close.form.pos</field>
        <field name="model">flousflow.account.period.close</field>
        <field name="inherit_id" ref="flousflow_period_close_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_pos_sessions" type="object"
                        class="oe_stat_button" icon="fa-shopping-cart"
                        groups="point_of_sale.group_pos_user">
                    <field name="open_pos_session_count" widget="statinfo"
                           string="Open POS Sessions"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
