<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="flousflow_account_lock_date_action" model="ir.actions.act_window">
        <field name="name">Lock Dates</field>
        <field name="res_model">flousflow.account.lock.date</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="flousflow_account_lock_date_view_form" model="ir.ui.view">
        <field name="name">flousflow.account.lock.date.form</field>
        <field name="model">flousflow.account.lock.date</field>
        <field name="arch" type="xml">
            <form string="Lock Dates">
                <group>
                    <field name="company_id" options="{'no_create': True}"/>
                    <field name="fiscalyear_lock_date"/>
                    <field name="tax_lock_date"/>
                    <field name="sale_lock_date"/>
                    <field name="purchase_lock_date"/>
                    <field name="hard_lock_date"/>
                </group>
                <footer>
                    <button name="action_apply" string="Save" type="object" class="btn-primary"/>
                    <button string="Discard" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
