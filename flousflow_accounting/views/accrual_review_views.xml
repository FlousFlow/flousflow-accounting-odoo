<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
    <record id="flousflow_accrual_review_form_view" model="ir.ui.view">
        <field name="name">flousflow.account.accrual.review.form</field>
        <field name="model">flousflow.account.accrual.review</field>
        <field name="arch" type="xml">
            <form string="Accrual Review">
                <header><button name="action_generate" type="object" string="Generate" class="btn-primary"/></header>
                <group><field name="company_id" groups="base.group_multi_company"/><field name="review_type"/><field name="date_to"/><field name="total_amount" readonly="1"/></group>
                <field name="line_ids" nolabel="1">
                    <list><field name="document_name"/><field name="partner_id"/><field name="product_id"/><field name="logistics_quantity"/><field name="invoiced_quantity"/><field name="pending_quantity"/><field name="amount" sum="Accrual Amount"/><button name="action_open_source" type="object" icon="fa-external-link" title="Open Source"/></list>
                </field>
            </form>
        </field>
    </record>
    <record id="flousflow_accrual_review_action" model="ir.actions.act_window"><field name="name">Accrual Review</field><field name="res_model">flousflow.account.accrual.review</field><field name="view_mode">form</field><field name="target">new</field></record>
    <!-- Use Odoo's native order-line queues and its native accrual entry
         wizard. Keep the FlousFlow review wizard available as an extra tool. -->
    <record id="flousflow_purchase_accrual_list_view" model="ir.ui.view">
        <field name="name">flousflow.purchase.order.line.accrual.list</field>
        <field name="model">purchase.order.line</field>
        <field name="arch" type="xml">
            <list string="Purchase Accruals" create="false">
                <header>
                    <button string="Create Accrual Entries"
                            name="%(purchase.action_accrued_expense_entry_purchase_order_line)d"
                            type="action" class="btn btn-primary"
                            groups="account.group_account_user" data-hotkey="r"/>
                </header>
                <field name="currency_id" column_invisible="True"/>
                <field name="order_id"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="product_qty"/>
                <field name="qty_received_at_date" string="Received"/>
                <field name="qty_invoiced_at_date" string="Billed"/>
                <field name="uom_id" groups="uom.group_uom"/>
                <field name="price_unit" widget="monetary"/>
                <field name="amount_to_invoice_at_date" widget="monetary" sum="Total"/>
            </list>
        </field>
    </record>
    <record id="flousflow_sale_accrual_list_view" model="ir.ui.view">
        <field name="name">flousflow.sale.order.line.accrual.list</field>
        <field name="model">sale.order.line</field>
        <field name="arch" type="xml">
            <list string="Sales Accruals" create="false">
                <header>
                    <button string="Create Accrual Entries"
                            name="%(sale.action_accrued_revenue_entry_sale_order_line)d"
                            type="action" class="btn btn-primary"
                            groups="account.group_account_user" data-hotkey="r"/>
                </header>
                <field name="currency_id" column_invisible="True"/>
                <field name="order_id"/>
                <field name="order_partner_id"/>
                <field name="name" optional="show"/>
                <field name="salesman_id" optional="show"/>
                <field name="product_uom_qty"/>
                <field name="qty_delivered_at_date" string="Delivered"/>
                <field name="qty_invoiced_at_date" string="Invoiced"/>
                <field name="product_uom_id" groups="uom.group_uom" widget="many2one_uom"/>
                <field name="price_unit" widget="monetary"/>
                <field name="amount_to_invoice_at_date" widget="monetary"/>
                <field name="unit_cost" string="Unit Cost" optional="show"/>
                <field name="total_cost" optional="show"/>
            </list>
        </field>
    </record>
    <record id="flousflow_bills_to_receive_action" model="ir.actions.act_window">
        <field name="name">Bills To Receive</field>
        <field name="res_model">purchase.order.line</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="flousflow_purchase_accrual_list_view"/>
        <field name="search_view_id" ref="purchase.purchase_order_line_search"/>
        <field name="domain">[('bill_to_receive', '=', True)]</field>
        <field name="context">{'search_default_last_365_days': 1, 'search_default_groupby_vendor': 1, 'accrual_type': 'bill_to_receive'}</field>
    </record>
    <record id="flousflow_billed_not_received_action" model="ir.actions.act_window">
        <field name="name">Billed Not Received</field>
        <field name="res_model">purchase.order.line</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="flousflow_purchase_accrual_list_view"/>
        <field name="search_view_id" ref="purchase.purchase_order_line_search"/>
        <field name="domain">[('prepaid_expense', '=', True)]</field>
        <field name="context">{'search_default_last_365_days': 1, 'search_default_groupby_vendor': 1, 'accrual_type': 'billed_not_received'}</field>
    </record>
    <record id="flousflow_invoices_to_be_issued_action" model="ir.actions.act_window">
        <field name="name">Invoices To Be Issued</field>
        <field name="res_model">sale.order.line</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="flousflow_sale_accrual_list_view"/>
        <field name="search_view_id" ref="sale.view_sales_order_line_filter"/>
        <field name="domain">[('invoice_to_be_issued', '=', True)]</field>
        <field name="context">{'search_default_last_365_days': 1, 'search_default_groupby_customer': 1, 'accrual_type': 'invoice_to_be_issued'}</field>
    </record>
    <record id="flousflow_invoiced_not_delivered_action" model="ir.actions.act_window">
        <field name="name">Invoiced Not Delivered</field>
        <field name="res_model">sale.order.line</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="flousflow_sale_accrual_list_view"/>
        <field name="search_view_id" ref="sale.view_sales_order_line_filter"/>
        <field name="domain">[('deferred_revenue', '=', True)]</field>
        <field name="context">{'search_default_last_365_days': 1, 'search_default_groupby_customer': 1, 'accrual_type': 'invoiced_not_delivered'}</field>
    </record>

    <record id="flousflow_account_tag_action" model="ir.actions.act_window">
        <field name="name">Account Tags</field>
        <field name="res_model">account.account.tag</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="account.account_tag_view_search"/>
    </record>
    </data>
</odoo>
