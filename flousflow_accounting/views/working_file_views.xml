<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="flousflow_working_file_list_view" model="ir.ui.view"><field name="name">flousflow.account.working.file.list</field><field name="model">flousflow.account.working.file</field><field name="arch" type="xml"><list decoration-success="state == 'approved'" decoration-muted="state in ('cancelled', 'paused')"><field name="name"/><field name="title"/><field name="date"/><field name="period_start"/><field name="period_end"/><field name="owner_id"/><field name="reviewer_id"/><field name="state" widget="badge"/></list></field></record>
    <record id="flousflow_working_file_kanban_view" model="ir.ui.view"><field name="name">flousflow.account.working.file.kanban</field><field name="model">flousflow.account.working.file</field><field name="arch" type="xml"><kanban default_group_by="state"><field name="name"/><field name="title"/><field name="date"/><field name="period_start"/><field name="period_end"/><field name="owner_id"/><field name="reviewer_id"/><field name="state"/><templates><t t-name="card"><div class="oe_kanban_global_click"><div class="fw-bold"><field name="name"/></div><div><field name="title"/></div><div class="text-muted"><field name="period_start"/> — <field name="period_end"/></div><div><field name="owner_id"/> · <field name="reviewer_id"/></div><field name="state" widget="badge"/></div></t></templates></kanban></field></record>
    <record id="flousflow_working_file_form_view" model="ir.ui.view"><field name="name">flousflow.account.working.file.form</field><field name="model">flousflow.account.working.file</field><field name="arch" type="xml"><form string="Audit Working File">
        <header><button name="action_submit" type="object" string="Submit for Review" class="btn-primary" invisible="state != 'draft'"/><button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="state != 'in_review'" groups="account.group_account_manager"/><button name="action_pause" type="object" string="Pause" invisible="state not in ('draft', 'in_review')"/><button name="action_resume" type="object" string="Resume" class="btn-primary" invisible="state != 'paused'"/><button name="action_cancel" type="object" string="Cancel" invisible="state in ('approved','cancelled')"/><button name="action_reset_draft" type="object" string="Reset to Draft" invisible="state not in ('in_review','paused','cancelled')"/><field name="state" widget="statusbar" statusbar_visible="draft,in_review,paused,approved,cancelled"/></header>
        <sheet><div class="oe_title"><label for="name"/><h1><field name="name"/></h1><h2><field name="title" placeholder="Working file title"/></h2></div><group invisible="state != 'paused'"><field name="paused_from_state" readonly="1"/></group>
        <group><group><field name="date"/><field name="period_start"/><field name="period_end"/><field name="company_id" groups="base.group_multi_company"/></group><group><field name="owner_id"/><field name="reviewer_id"/><field name="approved_by_id" invisible="state != 'approved'"/><field name="approved_date" invisible="state != 'approved'"/></group></group>
        <notebook><page string="Scope"><field name="objective"/><field name="account_ids" widget="many2many_tags"/><field name="move_ids"/></page><page string="Procedures"><field name="procedures"/></page><page string="Findings &amp; Conclusion"><field name="findings"/><field name="conclusion"/></page><page string="Evidence"><field name="attachment_ids" widget="many2many_binary"/></page></notebook></sheet><chatter/></form></field></record>
    <record id="flousflow_working_file_search_view" model="ir.ui.view"><field name="name">flousflow.account.working.file.search</field><field name="model">flousflow.account.working.file</field><field name="arch" type="xml"><search><field name="name"/><field name="title"/><field name="owner_id"/><field name="reviewer_id"/><filter name="todo_returns" string="To Do" domain="[('state', 'in', ('draft', 'in_review'))]"/><filter name="paused_returns" string="Paused" domain="[('state', '=', 'paused')]"/><filter name="my_files" string="My Files" domain="[('owner_id','=',uid)]"/><filter name="in_review" string="In Review" domain="[('state','=','in_review')]"/><separator/><filter name="group_owner" string="Owner" context="{'group_by':'owner_id'}"/><filter name="group_state" string="Status" context="{'group_by':'state'}"/></search></field></record>
    <record id="flousflow_working_file_action" model="ir.actions.act_window"><field name="name">Audit Working Files</field><field name="res_model">flousflow.account.working.file</field><field name="view_mode">kanban,list,form</field><field name="context" eval="{'search_default_todo_returns': 1, 'search_default_paused_returns': 1}"/><field name="search_view_id" ref="flousflow_working_file_search_view"/></record>
</odoo>
