<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_move_form_flousflow_assets" model="ir.ui.view">
        <field name="name">account.move.form.flousflow.assets</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_flousflow_assets" type="object"
                        class="oe_stat_button" icon="fa-cubes"
                        invisible="move_type != 'in_invoice' or not flousflow_asset_count">
                    <field name="flousflow_asset_count" widget="statinfo" string="Assets"/>
                </button>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_create_flousflow_assets" type="object"
                        string="Create Assets" class="btn-secondary"
                        groups="account.group_account_user"
                        invisible="move_type != 'in_invoice' or state != 'posted'"/>
            </xpath>
        </field>
    </record>

    <record id="flousflow_asset_create_wizard_view_form" model="ir.ui.view">
        <field name="name">flousflow.account.asset.create.wizard.form</field>
        <field name="model">flousflow.account.asset.create.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Assets">
                <group>
                    <field name="move_id"/>
                    <field name="company_id" invisible="1"/>
                    <field name="category_id"/>
                    <field name="line_ids" widget="many2many_tags"
                           domain="[('move_id', '=', move_id), ('display_type', '=', 'product')]"/>
                </group>
                <footer>
                    <button name="action_create_assets" type="object"
                            string="Create Assets" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
