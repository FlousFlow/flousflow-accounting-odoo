<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_flousflow_bank_reconcile_session_form" model="ir.ui.view">
        <field name="name">flousflow.account.bank.reconcile.session.form</field>
        <field name="model">flousflow.account.bank.reconcile.session</field>
        <field name="arch" type="xml">
            <form string="Manual Bank Reconciliation">
                <sheet>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="statement_line_id" options="{'no_create': True}"/>
                            <field name="journal_id"/>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="payment_ref"/>
                            <field name="amount"/>
                            <field name="selected_amount"/>
                            <field name="remaining_amount"/>
                        </group>
                    </group>
                    <button name="action_refresh_candidates" type="object" string="Refresh Suggestions" class="btn-secondary" icon="fa-refresh"/>
                    <field name="candidate_ids" nolabel="1">
                        <list editable="bottom" create="0" delete="0" default_order="score desc">
                            <field name="selected"/>
                            <field name="score" widget="progressbar"/>
                            <field name="date"/>
                            <field name="maturity_date" optional="hide"/>
                            <field name="move_id"/>
                            <field name="partner_id"/>
                            <field name="account_id"/>
                            <field name="residual"/>
                            <field name="match_amount"/>
                            <field name="match_reason"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button name="action_reconcile" type="object" string="Reconcile" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_flousflow_manual_bank_reconciliation" model="ir.actions.act_window">
        <field name="name">Manual Bank Reconciliation</field>
        <field name="res_model">flousflow.account.bank.reconcile.session</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="action_server_flousflow_open_bank_reconciliation" model="ir.actions.server">
        <field name="name">Reconcile Bank Transaction</field>
        <field name="model_id" ref="account.model_account_bank_statement_line"/>
        <field name="binding_model_id" ref="account.model_account_bank_statement_line"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">action = records[:1].action_open_flousflow_reconciliation()</field>
    </record>
</odoo>
