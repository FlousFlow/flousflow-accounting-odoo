<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="flousflow_payment_promise_view_list" model="ir.ui.view"><field name="name">flousflow.account.payment.promise.list</field><field name="model">flousflow.account.payment.promise</field><field name="arch" type="xml"><list decoration-success="state == 'kept'" decoration-danger="state == 'broken'"><field name="partner_id"/><field name="move_line_id"/><field name="amount"/><field name="promise_date"/><field name="responsible_id"/><field name="state" widget="badge"/><field name="company_id" groups="base.group_multi_company"/></list></field></record>
