<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_recurring_payments" model="ir.cron">
            <field name="name">FlousFlow Accounting: Generate Recurring Payments</field>
            <field name="model_id" ref="model_flousflow_account_recurring_line"/>
            <field name="state">code</field>
            <field name="code">model._cron_generate_due_payments()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="priority">10</field>
        </record>
    </data>
</odoo>
