<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="flousflow_accounting.apr__AgedPartnerReport" owl="1">
        <div class="o_action ff_aged_partner_report">
            <div class="ff_aged_toolbar">
                <button class="btn btn-primary" t-on-click="this.printReport">Print</button>
                <h2 t-out="this.title"/>
                <div class="ff_aged_filters">
                    <input class="form-control" type="date" aria-label="As of date"
                           t-att-value="this.state.dateFrom"
                           t-on-change="(ev) => this.onFilterChange('dateFrom', ev)"/>
                    <select class="form-select" aria-label="Account type"
                            t-att-value="this.state.resultSelection"
                            t-on-change="(ev) => this.onFilterChange('resultSelection', ev)">
                        <option value="customer">Receivable</option>
                        <option value="supplier">Payable</option>
                        <option value="customer_supplier">Receivable and Payable</option>
                    </select>
                    <select class="form-select" aria-label="Aging basis"
                            t-att-value="this.state.dateBasis"
                            t-on-change="(ev) => this.onFilterChange('dateBasis', ev)">
                        <option value="due_date">Based on due date</option>
                        <option value="invoice_date">Based on invoice date</option>
                    </select>
                    <div class="input-group ff_aged_period">
                        <span class="input-group-text">Days</span>
                        <input class="form-control" type="number" min="1" max="3660"
                               t-att-value="this.state.periodLength"
                               t-on-change="(ev) => this.onFilterChange('periodLength', ev)"/>
                    </div>
                    <select class="form-select" aria-label="Target moves"
                            t-att-value="this.state.targetMove"
                            t-on-change="(ev) => this.onFilterChange('targetMove', ev)">
                        <option value="posted">Posted Entries</option>
                        <option value="all">All Entries</option>
                    </select>
                    <select class="form-select ff_aged_scale" aria-label="Currency scale"
                            t-att-value="this.state.scale"
                            t-on-change="(ev) => this.state.scale = ev.target.value">
                        <option value="unit">In .$</option>
                        <option value="rounded">In $</option>
                        <option value="thousand">In k$</option>
                        <option value="million">In M$</option>
                    </select>
                </div>
                <div class="ff_aged_partner_filter">
                    <input class="form-control" type="search" placeholder="Search partners"
                           t-att-value="this.state.partnerQuery" t-on-input="this.searchPartners"/>
                    <div t-if="this.state.partnerOptions.length" class="ff_aged_partner_options">
                        <button t-foreach="this.state.partnerOptions" t-as="partner" t-key="partner.id"
                                class="dropdown-item" t-on-click="() => this.addPartner(partner)"
                                t-out="partner.name"/>
                    </div>
                    <span t-foreach="this.state.selectedPartners" t-as="partner" t-key="partner.id"
                          class="badge text-bg-secondary me-1">
                        <t t-out="partner.name"/>
                        <button class="btn-close btn-close-white ms-1" aria-label="Remove partner"
                                t-on-click="() => this.removePartner(partner.id)"/>
                    </span>
                </div>
            </div>
            <div class="o_content ff_aged_content">
                <div t-if="this.state.loading" class="text-center p-5">
                    <i class="fa fa-spinner fa-spin me-2"/>Loading…
                </div>
                <div t-else="" class="table-responsive">
                    <table class="table table-hover ff_aged_table">
                        <thead>
                            <tr>
                                <th>Partner</th>
                                <th class="text-end">Not Due</th>
                                <th t-foreach="this.bucketLabels" t-as="label" t-key="label" class="text-end" t-out="label"/>
                                <th class="text-end">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-if="!this.state.rows.length">
                                <td colspan="8" class="text-center text-muted py-5">No data found</td>
                            </tr>
                            <t t-foreach="this.state.rows" t-as="row" t-key="row.partner_id || row.name">
                                <tr class="ff_aged_partner_row">
                                    <td>
                                        <button class="btn btn-link p-0 me-2" t-on-click="() => this.togglePartner(row)">
                                            <i t-att-class="this.state.expandedIds.includes(row.partner_id) ? 'fa fa-caret-down' : 'fa fa-caret-right'"/>
                                        </button>
                                        <strong t-out="row.name"/>
                                        <button t-if="row.partner_id" class="btn btn-link btn-sm ms-2" type="button"
                                                t-on-click="() => this.openPartner(row.partner_id)">Partner</button>
                                        <button t-if="row.partner_id" class="btn btn-link btn-sm" type="button"
                                                t-on-click="() => this.openOpenItems(row.partner_id)">Open Items</button>
                                    </td>
                                    <td class="text-end" t-out="this.formatAmount(row.not_due)"/>
                                    <td t-foreach="row.buckets" t-as="amount" t-key="amount_index" class="text-end" t-out="this.formatAmount(amount)"/>
                                    <td class="text-end fw-bold" t-out="this.formatAmount(row.total)"/>
                                </tr>
                                <tr t-if="this.state.expandedIds.includes(row.partner_id)" t-foreach="row.lines" t-as="line" t-key="line.id" class="ff_aged_detail_row">
                                    <td>
                                        <button class="btn btn-link p-0" t-on-click="() => this.openMove(line.move_id)" t-out="line.label"/>
                                        <small class="d-block text-muted"><t t-out="this.formatDate(line.invoice_date)"/> · <t t-out="this.formatDate(line.due_date)"/></small>
                                    </td>
                                    <td class="text-end" t-out="line.period === 6 ? this.formatAmount(line.amount) : ''"/>
                                    <td t-foreach="row.buckets" t-as="_amount" t-key="_amount_index" class="text-end">
                                        <t t-if="line.period === 5 - _amount_index" t-out="this.formatAmount(line.amount)"/>
                                    </td>
                                    <td class="text-end" t-out="this.formatAmount(line.amount)"/>
                                </tr>
                            </t>
                        </tbody>
                        <tfoot>
                            <tr class="fw-bold">
                                <td>Total</td>
                                <td class="text-end" t-out="this.formatAmount(this.state.totals.not_due)"/>
                                <td t-foreach="this.state.totals.buckets" t-as="amount" t-key="amount_index" class="text-end" t-out="this.formatAmount(amount)"/>
                                <td class="text-end" t-out="this.formatAmount(this.state.totals.total)"/>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </t>
</templates>
