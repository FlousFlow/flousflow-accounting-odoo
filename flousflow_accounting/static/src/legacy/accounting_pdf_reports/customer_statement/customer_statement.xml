<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="flousflow_accounting.apr__CustomerStatement" owl="1">
        <div class="o_action ff_customer_statement">
            <div class="ff_cs_toolbar">
                <button class="btn btn-primary" t-on-click="this.printReport">
                    <i class="fa fa-print me-1"/> Print
                </button>
                <h2 class="ff_cs_title" t-out="this.reportTitle"/>
                <div class="dropdown ff_cs_more">
                    <button class="btn btn-link" type="button" title="More" aria-label="More"
                            t-att-aria-expanded="this.state.moreOpen"
                            t-on-click="() => this.state.moreOpen = !this.state.moreOpen">
                        <i class="fa fa-ellipsis-v"/>
                    </button>
                    <div t-if="this.state.moreOpen" class="dropdown-menu show">
                        <button class="dropdown-item" type="button" t-on-click="this.sendReport">
                            <i class="fa fa-envelope-o me-2"/>Send
                        </button>
                    </div>
                </div>
                <div class="dropdown ff_cs_settings">
                    <button class="btn btn-link" type="button" title="Report options" aria-label="Report options"
                            t-att-aria-expanded="this.state.settingsOpen"
                            t-on-click="() => this.state.settingsOpen = !this.state.settingsOpen">
                        <i class="fa fa-cog"/>
                    </button>
                    <div t-if="this.state.settingsOpen" class="dropdown-menu show">
                        <button class="dropdown-item" type="button" t-on-click="this.exportXlsx">
                            <i class="fa fa-file-excel-o me-2"/>XLSX
                        </button>
                    </div>
                </div>
                <div class="ff_cs_filters">
                    <div class="dropdown">
                        <button class="btn btn-outline-secondary dropdown-toggle" type="button"
                                t-on-click="() => this.state.periodOpen = !this.state.periodOpen">
                            <i class="fa fa-calendar me-1"/><t t-out="this.periodLabel"/>
                        </button>
                        <div t-if="this.state.periodOpen" class="dropdown-menu show p-2 ff_cs_period_menu">
                            <t t-foreach="['month', 'quarter', 'fiscal_year']" t-as="period" t-key="period">
                                <div class="d-flex align-items-center gap-1">
                                    <button t-att-class="'dropdown-item ' + (this.state.periodType === period ? 'active' : '')"
                                            t-on-click="() => this.setPeriod(period)">
                                        <t t-if="period === 'month'">Month</t>
                                        <t t-elif="period === 'quarter'">Quarter</t>
                                        <t t-else="">Fiscal Year</t>
                                    </button>
                                    <button class="btn btn-light btn-sm" t-att-aria-label="'Previous ' + period"
                                            t-on-click="() => this.movePeriod(period, -1)"><i class="fa fa-chevron-left"/></button>
                                    <span class="text-nowrap text-center ff_cs_period_option_label" t-out="this.getPeriodOptionLabel(period)"/>
                                    <button class="btn btn-light btn-sm" t-att-aria-label="'Next ' + period"
                                            t-on-click="() => this.movePeriod(period, 1)"><i class="fa fa-chevron-right"/></button>
                                </div>
                            </t>
                            <button t-att-class="'dropdown-item ' + (this.state.periodType === 'custom' ? 'active' : '')"
                                    t-on-click="() => this.setPeriod('custom')">Custom Dates</button>
                            <div t-if="this.state.periodType === 'custom'" class="d-flex gap-2 p-2">
                                <input class="form-control form-control-sm" type="date" aria-label="Start Date"
                                       t-att-value="this.state.customDateFrom"
                                       t-on-change="(ev) => this.setCustomDate('customDateFrom', ev)"/>
                                <input class="form-control form-control-sm" type="date" aria-label="End Date"
                                       t-att-value="this.state.customDateTo"
                                       t-on-change="(ev) => this.setCustomDate('customDateTo', ev)"/>
                            </div>
                        </div>
                    </div>
                    <div class="dropdown">
                        <button class="btn btn-outline-secondary dropdown-toggle" type="button"
                                t-on-click="() => this.state.filterOpen = !this.state.filterOpen">
                            <i class="fa fa-user me-1"/><t t-out="this.accountScopeLabel"/>
                        </button>
                        <div t-if="this.state.filterOpen" class="dropdown-menu show p-3 ff_cs_account_menu">
                            <div class="form-check" t-foreach="this.accountScopeOptions" t-as="scope" t-key="scope[0]">
                                <input class="form-check-input" type="checkbox" t-att-checked="this.state.accountScopes.includes(scope[0])"
                                       t-on-change="() => this.toggleAccountScope(scope[0])"/>
                                <label class="form-check-label" t-out="scope[1]"/>
                            </div>
                        </div>
                    </div>
                    <div class="dropdown ff_cs_partner_picker">
                        <button class="btn btn-outline-secondary dropdown-toggle" type="button"
                                t-on-click="() => this.state.partnerFilterOpen = !this.state.partnerFilterOpen">
                            <i class="fa fa-users me-1"/> Partners
                        </button>
                        <div t-if="this.state.partnerFilterOpen" class="dropdown-menu show p-2 ff_cs_partner_menu">
                            <input class="form-control form-control-sm mb-2" type="search" placeholder="Search partners"
                                   t-att-value="this.state.partnerSearch"
                                   t-on-input="(ev) => { this.state.partnerSearch = ev.target.value; this.searchPartners(); }"
                                   t-on-click="(ev) => ev.stopPropagation()"/>
                            <button t-foreach="this.state.partnerOptions" t-as="partner" t-key="partner.id"
                                    class="dropdown-item" type="button" t-on-click="() => this.addPartner(partner)"
                                    t-out="partner.name"/>
                            <div t-if="!this.state.partnerOptions.length" class="dropdown-item-text text-muted">No partners found</div>
                            <div class="dropdown-divider"/>
                            <div class="small text-muted mb-1">Tags</div>
                            <label class="form-check" t-foreach="this.state.tags" t-as="tag" t-key="tag.id">
                                <input class="form-check-input" type="checkbox" t-att-checked="this.state.selectedTagIds.includes(tag.id)"
                                       t-on-change="() => this.toggleTag(tag.id)"/>
                                <span class="form-check-label" t-out="tag.name"/>
                            </label>
                        </div>
                    </div>
                    <div class="dropdown">
                        <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                            <i class="fa fa-sliders me-1"/><t t-if="this.state.targetMove === 'posted'">Posted Entries</t>
                            <t t-elif="this.state.targetMove === 'draft'">Draft Entries</t><t t-else="">All Entries</t>
                        </button>
                        <div class="dropdown-menu">
                            <button t-foreach="[['posted', 'Posted Entries'], ['draft', 'Draft Entries'], ['all', 'All Entries']]"
                                    t-as="option" t-key="option[0]" class="dropdown-item" type="button"
                                    t-on-click="() => this.setTargetMove(option[0])" t-out="option[1]"/>
                        </div>
                    </div>
                    <select class="form-select ff_cs_scale" aria-label="Currency scale"
                            t-att-value="this.state.scale" t-on-change="(ev) => this.state.scale = ev.target.value">
                        <option value="unit">In .$</option><option value="rounded">In $</option>
                        <option value="thousand">In k$</option><option value="million">In M$</option>
                    </select>
                </div>
            </div>
            <div class="o_content">
                <div t-if="this.state.targetMove === 'posted' &amp;&amp; this.state.draftCount"
                     class="alert alert-info mb-2" role="status">
                    There are unposted Journal Entries prior to or included in this period.
                </div>
                <div t-if="this.state.selectedPartners.length" class="ff_cs_selected_partners">
                    <span t-foreach="this.state.selectedPartners" t-as="partner" t-key="partner.id" class="badge rounded-pill text-bg-secondary">
                        <t t-out="partner.name"/>
                        <button type="button" class="btn-close btn-close-white ms-1" aria-label="Remove partner"
                                t-on-click="() => this.removePartner(partner.id)"/>
                    </span>
                </div>
                <div t-if="this.state.loading" class="text-center p-5"><i class="fa fa-spinner fa-spin me-2"/>Loading…</div>
                <div t-else="" class="ff_cs_table_wrap">
                    <table class="table table-hover ff_cs_table">
                        <thead><tr><th></th><th>Date</th><th>Due Date</th>
                            <th class="text-end">Amount</th><th class="text-end">Amount in Currency</th><th/></tr></thead>
                        <tbody><tr class="ff_cs_report_row">
                            <th><t t-out="this.reportTitle"/></th><td/><td/><td/><td/>
                            <td class="ff_cs_info_cell">
                                <button class="btn btn-link btn-sm ff_cs_info_button" type="button"
                                        aria-label="Report calculation details" t-on-click="() => this.toggleInfo('report')">
                                    <i class="fa fa-info-circle"/>
                                </button>
                                <div t-if="this.state.infoOpenFor === 'report'" class="ff_cs_info_popover" role="tooltip">
                                    <div class="ff_cs_info_line"><span>Engine</span><strong>Custom Python Function</strong></div>
                                    <div t-foreach="this.statementInfoRows" t-as="info" t-key="info.label" class="ff_cs_info_card">
                                        <div class="ff_cs_info_line"><span>Label</span><span t-out="info.label"/></div>
                                        <div class="ff_cs_info_line"><span>Formula</span><code t-out="info.formula"/></div>
                                        <div class="ff_cs_info_line"><span>Sub Formula</span><code t-out="info.subFormula"/></div>
                                        <div class="ff_cs_info_line"><span>Value</span><span t-out="info.value"/></div>
                                    </div>
                                </div>
                            </td>
                        </tr></tbody>
                        <tbody t-foreach="this.state.partners" t-as="partner" t-key="partner.id">
                            <tr class="ff_cs_partner_row">
                                <th colspan="3">
                                    <button class="btn btn-link p-0 me-2" type="button"
                                            t-att-aria-expanded="this.isPartnerExpanded(partner.id)"
                                            t-att-aria-label="this.isPartnerExpanded(partner.id) ? 'Collapse partner' : 'Expand partner'"
                                            t-on-click="() => this.togglePartner(partner.id)">
                                        <i t-att-class="this.isPartnerExpanded(partner.id) ? 'fa fa-caret-down' : 'fa fa-caret-right'"/>
                                    </button>
                                    <span t-out="partner.name"/>
                                    <span class="ff_cs_partner_controls ms-3">
                                        <button class="btn btn-link btn-sm" type="button"
                                                t-on-click="() => this.openPartner(partner.id)">Partner</button>
                                        <button class="btn btn-link btn-sm" type="button"
                                                t-on-click="() => this.openPartnerJournalItems(partner)">Journal Items</button>
                                    </span>
                                </th>
                                <th class="text-end" t-out="this.formatAmount(partner.amount)"/><th/><th/></tr>
                            <tr t-if="this.isPartnerExpanded(partner.id)" t-foreach="partner.lines" t-as="line" t-key="line.id" class="ff_cs_move_row">
                                <td>
                                    <div class="d-flex align-items-center gap-1">
                                        <button class="btn btn-link p-0" t-att-title="line.reference || line.label"
                                                t-on-click="() => this.openMove(line.move_id)"
                                                t-out="line.label"/>
                                        <div class="dropdown ff_cs_move_actions">
                                            <button class="btn btn-link btn-sm p-0" type="button"
                                                    aria-label="Journal entry actions"
                                                    t-on-click.stop="() => this.toggleMoveAction(line.id)">
                                                <i class="fa fa-ellipsis-v"/>
                                            </button>
                                            <div t-if="this.state.moveActionOpenFor === line.id" class="dropdown-menu show">
                                                <button class="dropdown-item" type="button"
                                                        t-on-click="() => this.openMove(line.move_id)">
                                                    View Journal Entry
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                <td t-out="this.formatDate(line.date)"/>
                                <td><t t-out="this.formatDate(line.date_maturity)"/></td>
                                <td class="text-end" t-out="this.formatAmount(line.amount)"/>
                                <td class="text-end" t-out="this.formatForeignAmount(line)"/>
                                <td/>
                            </tr>
                        </tbody>
                        <tfoot t-if="this.state.lineCount"><tr class="fw-bold ff_cs_total_row">
                            <th colspan="3">Total</th>
                            <th class="text-end" t-out="this.formatAmount(this.totalAmount)"/><th/>
                            <td class="ff_cs_info_cell">
                                <button class="btn btn-link btn-sm ff_cs_info_button" type="button"
                                        aria-label="Total calculation details" t-on-click="() => this.toggleInfo('total')">
                                    <i class="fa fa-info-circle"/>
                                </button>
                                <div t-if="this.state.infoOpenFor === 'total'" class="ff_cs_info_popover" role="tooltip">
                                    <div class="ff_cs_info_line"><span>Engine</span><strong>Custom Python Function</strong></div>
                                    <div t-foreach="this.statementInfoRows" t-as="info" t-key="info.label" class="ff_cs_info_card">
                                        <div class="ff_cs_info_line"><span>Label</span><span t-out="info.label"/></div>
                                        <div class="ff_cs_info_line"><span>Formula</span><code t-out="info.formula"/></div>
                                        <div class="ff_cs_info_line"><span>Sub Formula</span><code t-out="info.subFormula"/></div>
                                        <div class="ff_cs_info_line"><span>Value</span><span t-out="info.value"/></div>
                                    </div>
                                </div>
                            </td>
                        </tr></tfoot>
                    </table>
                </div>
            </div>
        </div>
    </t>
</templates>
