<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="flousflow_accounting.apr__TrialBalance" owl="1">
        <div class="o_action ff_trial_balance">
            <div class="ff_tb_toolbar">
                <div class="ff_tb_title"><h2>Trial Balance</h2><span t-out="this.state.companyName"/></div>
                <div class="d-flex align-items-center flex-wrap gap-2">
                    <label class="visually-hidden" for="ff_tb_search">Search accounts</label>
                    <input id="ff_tb_search" class="form-control ff_tb_search" type="search"
                           placeholder="Search accounts" t-att-value="this.state.search"
                           t-on-input="(ev) => this.state.search = ev.target.value"/>
                    <div class="dropdown ff_tb_period_picker">
                        <button class="btn btn-outline-secondary dropdown-toggle" type="button"
                                t-on-click="() => this.state.periodPickerOpen = !this.state.periodPickerOpen">
                            <i class="fa fa-calendar me-1"/><t t-out="this.periodLabel"/>
                        </button>
                        <div t-if="this.state.periodPickerOpen" class="dropdown-menu show p-2 ff_tb_period_menu">
                            <t t-foreach="['month', 'quarter', 'fiscal_year']" t-as="periodType" t-key="periodType">
                                <div class="d-flex align-items-center gap-1 ff_tb_period_option">
                                    <button t-att-class="'dropdown-item ' + (this.state.periodType === periodType ? 'active' : '')"
                                            t-on-click="() => this.setPeriodType(periodType)">
                                        <t t-if="periodType === 'month'">Month</t>
                                        <t t-elif="periodType === 'quarter'">Quarter</t>
                                        <t t-else="">Fiscal Year</t>
                                    </button>
                                    <button class="btn btn-light btn-sm" t-att-aria-label="'Previous ' + periodType"
                                            t-on-click="() => this.navigatePeriod(periodType, -1)"><i class="fa fa-chevron-left"/></button>
                                    <span class="text-nowrap" t-out="this.getPeriodOptionLabel(periodType)"/>
                                    <button class="btn btn-light btn-sm" t-att-aria-label="'Next ' + periodType"
                                            t-on-click="() => this.navigatePeriod(periodType, 1)"><i class="fa fa-chevron-right"/></button>
                                </div>
                            </t>
                            <button t-att-class="'dropdown-item ' + (this.state.periodType === 'custom' ? 'active' : '')"
                                    t-on-click="() => this.setPeriodType('custom')">Custom Dates</button>
                            <div t-if="this.state.periodType === 'custom'" class="px-2 pt-2">
                                <div class="d-flex align-items-center gap-2">
                                    <input class="form-control form-control-sm" type="date" aria-label="Start Date"
                                           t-att-value="this.state.customDateFrom"
                                           t-on-change="(ev) => this.onCustomDateChange('customDateFrom', ev)"/>
                                    <span>to</span>
                                    <input class="form-control form-control-sm" type="date" aria-label="End Date"
                                           t-att-value="this.state.customDateTo"
                                           t-on-change="(ev) => this.onCustomDateChange('customDateTo', ev)"/>
                                </div>
                                <small t-if="this.state.customDateError" class="text-danger d-block mt-1"
                                       t-out="this.state.customDateError"/>
                            </div>
                        </div>
                    </div>
                    <button t-att-class="'btn ' + (this.state.comparison ? 'btn-primary' : 'btn-outline-secondary')"
                            t-on-click="() => { this.state.comparison = !this.state.comparison; this.loadReport(); }">Comparison</button>
                    <div class="dropdown">
                        <button class="btn btn-outline-secondary dropdown-toggle ff_tb_entry_filter" type="button"
                                t-on-click="() => this.state.filterOpen = !this.state.filterOpen">
                            <i class="fa fa-sliders me-1"/><t t-if="this.state.targetMove === 'posted'">Posted Entries</t>
                            <t t-else="">All Entries</t>, <t t-if="this.state.cashBasis">Cash Basis</t><t t-else="">Accrual Basis</t>
                        </button>
                        <div t-if="this.state.filterOpen" class="dropdown-menu show p-3 ff_tb_filters">
                            <label class="form-check mb-2">
                                <input class="form-check-input" type="radio" name="ff_tb_target_move"
                                       t-att-checked="this.state.targetMove === 'posted'"
                                       t-on-change="() => { this.state.targetMove = 'posted'; this.loadReport(); }"/>
                                <span class="form-check-label">Posted Entries</span>
                            </label>
                            <label class="form-check mb-2">
                                <input class="form-check-input" type="radio" name="ff_tb_target_move"
                                       t-att-checked="this.state.targetMove === 'all'"
                                       t-on-change="() => { this.state.targetMove = 'all'; this.loadReport(); }"/>
                                <span class="form-check-label">All Entries</span>
                            </label>
                            <label class="form-check mb-2 ff_tb_cash_basis">
                                <input class="form-check-input" type="checkbox"
                                       t-att-checked="this.state.cashBasis"
                                       t-on-change="() => { this.state.cashBasis = !this.state.cashBasis; this.loadReport(); }"/>
                                <span class="form-check-label">Cash Basis Method</span>
                            </label>
                            <label class="form-label mt-2" for="ff_tb_display">Display Accounts</label>
                            <select id="ff_tb_display" class="form-select mb-2" t-att-value="this.state.displayAccount"
                                    t-on-change="(ev) => { this.state.displayAccount = ev.target.value; this.loadReport(); }">
                                <option value="movement">With movements</option>
                                <option value="not_zero">With balance not equal to zero</option>
                                <option value="all">All accounts</option>
                            </select>
                            <label class="form-label" for="ff_tb_journals">Journals</label>
                            <select id="ff_tb_journals" class="form-select" multiple="multiple" size="6"
                                    t-on-change="this.onJournalChange">
                                <option t-foreach="this.state.journals" t-as="journal" t-key="journal.id"
                                        t-att-value="journal.id" t-att-selected="this.state.journalIds.includes(journal.id)"
                                        t-out="journal.name"/>
                            </select>
                        </div>
                    </div>
                    <select class="form-select ff_tb_scale" aria-label="Display amounts" t-att-value="this.state.scale"
                            t-on-change="(ev) => this.state.scale = ev.target.value">
                        <option value="unit">In .$</option><option value="rounded">In $</option>
                        <option value="thousand">In k$</option><option value="million">In M$</option>
                    </select>
                    <button class="btn btn-primary" t-on-click="this.printReport"><i class="fa fa-print me-1"/>Print</button>
                </div>
            </div>
            <div class="o_content">
                <div t-if="this.state.draftCount and this.state.targetMove === 'posted' and !this.state.dismissedDraftWarning"
                     class="alert alert-info d-flex align-items-center justify-content-between" role="status">
                    <span>There are <strong t-out="this.state.draftCount"/> unposted Journal Entries prior to or included in this period.</span>
                    <button class="btn-close" aria-label="Close" t-on-click="() => this.state.dismissedDraftWarning = true"/>
                </div>
                <div t-if="this.state.loading" class="text-center p-5"><i class="fa fa-spinner fa-spin me-2"/>Loading…</div>
                <div t-else="" class="ff_tb_table_wrap">
                    <table class="table table-hover ff_tb_table">
                        <thead>
                            <tr>
                                <th rowspan="2">Account</th>
                                <th class="text-end" t-att-colspan="this.state.comparison ? 2 : 1">Opening Balance</th>
                                <th class="text-center" t-att-colspan="this.state.comparison ? 4 : 2"><t t-out="this.periodColumnLabel"/></th>
                                <th class="text-end" t-att-colspan="this.state.comparison ? 2 : 1">Ending Balance</th>
                            </tr>
                            <tr>
                                <th class="text-end">Balance</th>
                                <th t-if="this.state.comparison" class="text-end">Previous Balance</th>
                                <th class="text-end">Debit</th><th class="text-end">Credit</th>
                                <th t-if="this.state.comparison" class="text-end">Previous Debit</th>
                                <th t-if="this.state.comparison" class="text-end">Previous Credit</th>
                                <th class="text-end">Balance</th>
                                <th t-if="this.state.comparison" class="text-end">Previous Balance</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-if="!this.visibleLines.length"><td t-att-colspan="this.state.comparison ? 9 : 5" class="text-center text-muted py-5">No data found</td></tr>
                            <tr t-foreach="this.visibleLines" t-as="line" t-key="line.account_id">
                                <td><button class="btn btn-link p-0 ff_tb_account" t-on-click="() => this.openOpeningBalance(line.account_id)"><t t-out="line.code"/> <t t-out="line.name"/></button></td>
                                <td class="text-end"><button class="btn btn-link p-0" t-on-click="() => this.openOpeningBalance(line.account_id)" t-out="this.formatAmount(line.opening_balance)"/></td>
                                <td t-if="this.state.comparison" class="text-end"><t t-out="this.formatAmount(line.opening_balance_cmp)"/></td>
                                <td class="text-end"><button class="btn btn-link p-0" t-on-click="() => this.openLineDetails(line.account_id, this.state.dateFrom, this.state.dateTo)" t-out="this.formatAmount(line.debit)"/></td>
                                <td class="text-end"><button class="btn btn-link p-0" t-on-click="() => this.openLineDetails(line.account_id, this.state.dateFrom, this.state.dateTo)" t-out="this.formatAmount(line.credit)"/></td>
                                <td t-if="this.state.comparison" class="text-end"><t t-out="this.formatAmount(line.debit_cmp)"/></td>
                                <td t-if="this.state.comparison" class="text-end"><t t-out="this.formatAmount(line.credit_cmp)"/></td>
                                <td class="text-end"><button class="btn btn-link p-0 fw-semibold" t-on-click="() => this.openLineDetails(line.account_id, false, this.state.dateTo)" t-out="this.formatAmount(line.balance)"/></td>
                                <td t-if="this.state.comparison" class="text-end"><t t-out="this.formatAmount(line.balance_cmp)"/></td>
                            </tr>
                            <tr t-if="this.visibleLines.length" class="ff_tb_total">
                                <td>Total</td>
                                <td class="text-end"><t t-out="this.formatAmount(this.visibleTotals.opening_balance)"/></td>
                                <td t-if="this.state.comparison" class="text-end"><t t-out="this.formatAmount(this.visibleTotals.opening_balance_cmp)"/></td>
                                <td class="text-end"><t t-out="this.formatAmount(this.visibleTotals.debit)"/></td>
                                <td class="text-end"><t t-out="this.formatAmount(this.visibleTotals.credit)"/></td>
                                <td t-if="this.state.comparison" class="text-end"><t t-out="this.formatAmount(this.visibleTotals.debit_cmp)"/></td>
                                <td t-if="this.state.comparison" class="text-end"><t t-out="this.formatAmount(this.visibleTotals.credit_cmp)"/></td>
                                <td class="text-end"><t t-out="this.formatAmount(this.visibleTotals.balance)"/></td>
                                <td t-if="this.state.comparison" class="text-end"><t t-out="this.formatAmount(this.visibleTotals.balance_cmp)"/></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </t>
</templates>
